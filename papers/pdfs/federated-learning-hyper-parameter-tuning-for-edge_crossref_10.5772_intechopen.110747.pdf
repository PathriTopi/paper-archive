":114,"count":3},{"group":"topic","caption":"Electrical and Electronic Engineering","value":116,"count":3},{"group":"topic","caption":"Energy Engineering","value":117,"count":3},{"group":"topic","caption":"Environmental Engineering","value":118,"count":2},{"group":"topic","caption":"Mechanical Engineering","value":121,"count":1},{"group":"topic","caption":"Vehicle Engineering","value":124,"count":1},{"group":"topic","caption":"Ecology","value":126,"count":2},{"group":"topic","caption":"Environmental Pollution","value":133,"count":1},{"group":"topic","caption":"Sustainable Management","value":145,"count":1},{"group":"topic","caption":"Applied Microbiology","value":148,"count":4},{"group":"topic","caption":"Biomaterials","value":154,"count":2},{"group":"topic","caption":"Metals and Nonmetals","value":158,"count":2},{"group":"topic","caption":"Surface Science","value":160,"count":1},{"group":"topic","caption":"Applied Mathematics","value":163,"count":1},{"group":"topic","caption":"Complementary Medicine","value":172,"count":1},{"group":"topic","caption":"Critical Care Medicine","value":173,"count":2},{"group":"topic","caption":"Diagnostics","value":176,"count":3},{"group":"topic","caption":"Emergency Medicine","value":177,"count":1},{"group":"topic","caption":"Endocrinology","value":178,"count":3},{"group":"topic","caption":"Gastroenterology","value":181,"count":3},{"group":"topic","caption":"Hematology","value":183,"count":1},{"group":"topic","caption":"Immunology, Allergology and Rheumatology","value":184,"count":3},{"group":"topic","caption":"Internal Medicine","value":185,"count":2},{"group":"topic","caption":"Mental and Behavioural Disorders and Diseases of the Nervous System","value":187,"count":3},{"group":"topic","caption":"Obstetrics and Gynecology","value":189,"count":5},{"group":"topic","caption":"Oncology","value":190,"count":3},{"group":"topic","caption":"Ophthalmology","value":191,"count":1},{"group":"topic","caption":"Otorhinolaryngology","value":192,"count":1},{"group":"topic","caption":"Physical Medicine and Rehabilitation","value":197,"count":1},{"group":"topic","caption":"Public Health","value":200,"count":1},{"group":"topic","caption":"Surgery","value":202,"count":5},{"group":"topic","caption":"Telemedicine","value":203,"count":1},{"group":"topic","caption":"Urology","value":204,"count":3},{"group":"topic","caption":"Neurobiology","value":213,"count":1},{"group":"topic","caption":"Neurophysiology","value":215,"count":1},{"group":"topic","caption":"Pharmacology","value":219,"count":2},{"group":"topic","caption":"Toxicology","value":220,"count":1},{"group":"topic","caption":"Fluid Mechanics","value":224,"count":1},{"group":"topic","caption":"Quantum Physics","value":231,"count":1},{"group":"topic","caption":"Industrial, Organizational and Work Psychology","value":236,"count":1},{"group":"topic","caption":"Education","value":265,"count":1},{"group":"topic","caption":"Humanities","value":270,"count":2},{"group":"topic","caption":"Sociology","value":281,"count":2},{"group":"topic","caption":"Developmental Psychology","value":1390,"count":2},{"group":"topic","caption":"Applied Physics","value":1394,"count":3}],"offset":12,"limit":12,"total":347},"ofsBookV4":{"item":{"type":"book","id":"1005640","leadTitle":null,"title":"Sustainable Practices in Managing Agricultural and Food Waste","fullTitle":"Sustainable Practices in Managing Agricultural and Food Waste","subtitle":null,"reviewType":"peer-reviewed","abstract":"\u003Cp\u003EOne of the most pressing challenges in today’s global food system is the huge volume of food that is thrown away throughout the food chain. Despite major advances in agricultural productivity, inefficiencies still persist across production, processing, distribution, retail, and consumer stages. These inefficiencies not only undermine food security but also increase environmental pressures through unnecessary land use, excessive water consumption, and avoidable greenhouse gas emissions.\u003C\u002Fp\u003E\r\n\r\n\u003Cp\u003EThe authors are invited to present an overview of the causes, consequences, and potential solutions to agricultural and food waste, drawing on current research, international case studies, and practical examples from across the value chain. They can highlight how technological innovation, policy reform, and changes in business practices and consumer behavior can significantly reduce waste while creating both economic and environmental benefits.\u003C\u002Fp\u003E\r\n\r\n\u003Cp\u003EThe book aims to help all readers-students, professionals, decision-makers, and anyone interested in sustainability, gain a clear understanding of the problem and learn practical, proven ways to reduce waste. In the end, the book hopes to encourage real action that will make our food system more efficient, stronger, and better for the environment.\u003C\u002Fp\u003E","isbn":"978-1-80632-447-7","printIsbn":"978-1-80632-448-4","pdfIsbn":"978-1-80632-449-1","doi":"10.5772\u002Fintechopen.1013873","oapfPrice":1650,"oapfPriceCurrency":"EUR","isOpenForSubmission":false,"isSalesforceBook":true,"isNomenclature":false,"hash":"44ca15622a178f8b0e036cfd7e42fcb7","bookSignature":"Dr. Gabriel Mustățea","publishedDate":null,"coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000Ns9RKIAZ\u002F0017544_TrikoderCover%20%282025-12-03%2012%3A48%3A51%29.jpg","keywords":["Reducing Waste"," Supply Chain"," Climate Impacts"," Waste Management"," Harvest Losses"," Storage Infrastructure"," Circular Economy"," Precision Agriculture"," Smart Packaging"," Environmental Footprint"," Global Waste"," Consumer Behavior"],"dateEndFirstStepPublish":"21 April 2026","dateEndSecondStepPublish":"16 June 2026","dateEndThirdStepPublish":"21 July 2026","dateEndFourthStepPublish":"09 October 2026","dateEndFifthStepPublish":"16 January 2027","dateConfirmationOfParticipation":"11 June 2026","dateOldSubmissionDeadline":"19 May 2026","remainingDaysToSecondStep":"2 months","secondStepPassed":true,"areRegistrationsClosed":true,"currentStepOfPublishingProcess":4,"editedByType":null,"sdgRelated":true,"biosketch":"Food scientist with 60+ publications, major contributions to food safety, analysis of contaminants, circular economy, and food waste research, as well as leadership across 50 national and international projects.","equalEditorOneBiosketch":null,"equalEditorTwoBiosketch":null,"equalEditorThreeBiosketch":null,"coeditorOneBiosketch":null,"coeditorTwoBiosketch":null,"coeditorThreeBiosketch":null,"coeditorFourBiosketch":null,"coeditorFiveBiosketch":null,"isPublished":false,"isDeactivated":false,"ofsPageFlags":null,"hasEditors":true,"editors":[{"id":"441033","name":"Gabriel","surname":"Mustățea","fullName":"Gabriel Mustățea","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F441033\u002F1776233242\u002Fprofile\u002Fimage1.jpg","biography":"Gabriel Mustățea is a scientific researcher, technical director, and head of the Food Packaging Laboratory within the National R&D Institute for Food Bioresources—IBA Bucharest, Romania. He received a B.Sc. degree and an M.Sc. degree in Food Chemistry from the University POLITEHNICA of Bucharest, Faculty of Applied Chemistry and Materials Science (currently named Faculty of Chemical Engineering and Biotechnologies). In 2014, he received a Ph.D. degree in chemical engineering at the same university. His interests are related to food packaging and food contact materials, food safety and food security, food technology, analysis of contaminants, circular economy, and food waste. \r\nHe published more than 60 papers (more than 30 in WoS), 5 book chapters, and several books and brochures in Romanian. He was involved as a project manager or team member in more than 50 research projects (more than 10 at the international level).","institutionString":null,"countryString":null,"totalAuthoredChapters":"2","totalEditedBooks":"0","orcid":"0000-0002-8082-0951","institution":{"name":"Institutul de Bioresurse Alimentare","country":{"name":"Romania"}}}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"assistantEditorOne":null,"assistantEditorTwo":null,"assistantEditorThree":null,"assistantEditorFour":null,"assistantEditorFive":null,"topics":[{"id":"27","title":"Agricultural Science","slug":"agricultural-science"}],"productType":{"id":"1","title":"Edited Volume","chapterContentType":"chapter","authoredCaption":"Edited by"},"series":null,"subseries":null,"personalPublishingAssistant":{"id":"1004352","firstName":"Nina","lastName":"Miocevic","middleName":null,"title":"Ms.","email":"nina.m@intechopen.com"},"_preview":0,"vEditors":[{"id":"441033","name":"Gabriel","surname":"Mustățea","fullName":"Gabriel Mustățea","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F441033\u002F1776233242\u002Fprofile\u002Fimage1.jpg","biography":"Gabriel Mustățea is a scientific researcher, technical director, and head of the Food Packaging Laboratory within the National R&D Institute for Food Bioresources—IBA Bucharest, Romania. He received a B.Sc. degree and an M.Sc. degree in Food Chemistry from the University POLITEHNICA of Bucharest, Faculty of Applied Chemistry and Materials Science (currently named Faculty of Chemical Engineering and Biotechnologies). In 2014, he received a Ph.D. degree in chemical engineering at the same university. His interests are related to food packaging and food contact materials, food safety and food security, food technology, analysis of contaminants, circular economy, and food waste. \r\nHe published more than 60 papers (more than 30 in WoS), 5 book chapters, and several books and brochures in Romanian. He was involved as a project manager or team member in more than 50 research projects (more than 10 at the international level).","institutionString":null,"countryString":null,"totalAuthoredChapters":"2","totalEditedBooks":"0","orcid":"0000-0002-8082-0951","institution":{"name":"Institutul de Bioresurse Alimentare","country":{"name":"Romania"}}}],"vCoeditors":[],"vAssistantEditors":[],"editor":{"id":"441033","name":"Gabriel","surname":"Mustățea","fullName":"Gabriel Mustățea","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F441033\u002F1776233242\u002Fprofile\u002Fimage1.jpg","biography":"Gabriel Mustățea is a scientific researcher, technical director, and head of the Food Packaging Laboratory within the National R&D Institute for Food Bioresources—IBA Bucharest, Romania. He received a B.Sc. degree and an M.Sc. degree in Food Chemistry from the University POLITEHNICA of Bucharest, Faculty of Applied Chemistry and Materials Science (currently named Faculty of Chemical Engineering and Biotechnologies). In 2014, he received a Ph.D. degree in chemical engineering at the same university. His interests are related to food packaging and food contact materials, food safety and food security, food technology, analysis of contaminants, circular economy, and food waste. \r\nHe published more than 60 papers (more than 30 in WoS), 5 book chapters, and several books and brochures in Romanian. He was involved as a project manager or team member in more than 50 research projects (more than 10 at the international level).","institutionString":null,"countryString":null,"totalAuthoredChapters":"2","totalEditedBooks":"0","orcid":"0000-0002-8082-0951","institution":{"name":"Institutul de Bioresurse Alimentare","country":{"name":"Romania"}}},"editorCaption":"Gabriel Mustățea","authoredBy":"Edited by"},"relatedBooks":[{"type":"book","id":"8952","title":"Coffee","subtitle":"Production and Research","fullTitle":"Coffee - Production and Research","isOpenForSubmission":false,"hash":"ec7add8fac804b29cdb70b142414b49e","slug":"coffee-production-and-research","isPublished":true,"bookSignature":"Dalyse Toledo Castanheira","coverURL":"https:\u002F\u002Fcdn.int