06-30%2009%3A00%3A58%29.jpg","editedByType":null,"kuFlag":false,"editors":[{"id":"437295","title":"Dr.","name":"Giovanni","middleName":null,"surname":"Palleschi","slug":"giovanni-palleschi","fullName":"Giovanni Palleschi"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"561620","title":"Dr.","name":"Valeria","middleName":null,"surname":"Rossi","slug":"valeria-rossi","fullName":"Valeria Rossi"},"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"1003115","title":"Lithotripsy","subtitle":"Novel Technologies, Innovations and Contemporary Applications","isOpenForSubmission":false,"isPublished":true,"hash":"ffa9be59f1c618c4859645cd04b61f24","slug":null,"bookSignature":"Mohammad Hammad Ather, Athanasios Papatsoris and Srinath K. Chandrasekara","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa043Y00000zFsnpQAC\u002F0015019_TrikoderCover%20%282023-01-13%2008%3A17%3A12%29.jpg","editedByType":null,"kuFlag":false,"editors":[{"id":"88868","title":"Prof.","name":"Mohammad Hammad","middleName":null,"surname":"Ather","slug":"mohammad-hammad-ather","fullName":"Mohammad Hammad Ather"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"59245","title":"Prof.","name":"Athanasios","middleName":null,"surname":"Papatsoris","slug":"athanasios-papatsoris","fullName":"Athanasios Papatsoris"},"coeditorTwo":{"id":"530189","title":"Prof.","name":"Srinath","middleName":"K.","surname":"Chandrasekara","slug":"srinath-chandrasekara","fullName":"Srinath K. Chandrasekara"},"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}}],"booksByTopicTotal":72,"childTopics":[{"id":"1161","title":"Andrology","slug":"andrology","isLeaf":true,"numberOfBooks":10,"numberOfAuthorsAndEditors":247,"parent":{"id":"204"}},{"id":"1162","title":"Endourology","slug":"endourology","isLeaf":true,"numberOfBooks":10,"numberOfAuthorsAndEditors":251,"parent":{"id":"204"}},{"id":"1163","title":"Nephrology","slug":"nephrology","isLeaf":true,"numberOfBooks":39,"numberOfAuthorsAndEditors":1218,"parent":{"id":"204"}},{"id":"1164","title":"Sexology","slug":"urology-sexology","isLeaf":true,"numberOfBooks":1,"numberOfAuthorsAndEditors":19,"parent":{"id":"204"}},{"id":"1165","title":"Urologic Oncology","slug":"urologic-oncology","isLeaf":true,"numberOfBooks":6,"numberOfAuthorsAndEditors":140,"parent":{"id":"204"}}],"seriesByTopicCollection":[],"seriesByTopicTotal":0,"mostCitedChapters":[{"id":"37101","doi":"10.5772\u002F36832","title":"The Psychological Impact of Hemodialysis on Patients with Chronic Renal Failure","slug":"the-psychological-impact-of-hemodialysis-on-patients-with-chronic-renal-failure","totalDownloads":6647,"totalCrossrefCites":17,"totalDimensionsCites":40,"abstract":null,"isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1746","slug":"renal-failure-the-facts","title":"Renal Failure","fullTitle":"Renal Failure - The Facts","isOpenForSubmission":false,"isPublished":true},"signatures":"Liang-Jen Wang and Chih-Ken Chen","authors":[{"id":"110035","title":"Dr.","name":"Liang Jen","middleName":null,"surname":"Wang","slug":"liang-jen-wang","fullName":"Liang Jen Wang"}]},{"id":"48020","doi":"10.5772\u002F59430","title":"Dialysis Membranes — Physicochemical Structures and Features","slug":"dialysis-membranes-physicochemical-structures-and-features","totalDownloads":7049,"totalCrossrefCites":13,"totalDimensionsCites":29,"abstract":null,"isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"4547","slug":"updates-in-hemodialysis","title":"Updates in Hemodialysis","fullTitle":"Updates in Hemodialysis","isOpenForSubmission":false,"isPublished":true},"signatures":"Akihiro C. Yamashita and Kenji Sakurai","authors":[{"id":"171999","title":"Prof.","name":"Akihiro","middleName":null,"surname":"Yamashita","slug":"akihiro-yamashita","fullName":"Akihiro Yamashita"},{"id":"363113","title":"Dr.","name":"Kenji","middleName":null,"surname":"Sakurai","slug":"kenji-sakurai","fullName":"Kenji Sakurai"}]},{"id":"59074","doi":"10.5772\u002Fintechopen.73231","title":"The Role of Human Semen as an Early and Reliable Tool of Environmental Impact Assessment on Human Health","slug":"the-role-of-human-semen-as-an-early-and-reliable-tool-of-environmental-impact-assessment-on-human-he","totalDownloads":2539,"totalCrossrefCites":13,"totalDimensionsCites":27,"abstract":"Several studies have shown a dramatic reduction of semen quality in many industrialized countries and infertility is becoming a public health top priority, whose incidence is associated to late-onset adult diseases, especially cancer, shorter life expectancy and trans-generational effects. The male reproductive system is particularly sensitive to a broad variety of reproductive and developmental toxicants, including many environmental pollutants and recent studies suggest that human semen is an early and sensitive environmental and health marker. A set of semen biomarkers is described for reproductive health effects in relation to environmental exposure, where human semen seems to be an early and sensitive source of biomarkers than blood to monitor high environmental pressure on human health. Environmental health should consider reproductive health and development, from intrauterine life to childhood and puberty: these are both vulnerable targets and high-value protection goals, inasmuch as they represent the future of our societies. Hence, biomarkers of reproductive health should be exploited as early signals of environmental pressure and increased risk of adverse chronic health effects so that the use of “human seminal model” might be the main objective to be considered in the agenda of public prevention policies for early detection and innovative programs of health surveillance in environmental risk areas.","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"6079","slug":"spermatozoa-facts-and-perspectives","title":"Spermatozoa","fullTitle":"Spermatozoa - Facts and Perspectives","isOpenForSubmission":false,"isPublished":true},"signatures":"Luigi Montano, Paolo Bergamo, Maria Grazia Andreassi and\nStefano Lorenzetti","authors":[{"id":"206180","title":"Dr.","name":"Luigi","middleName":null,"surname":"Montano","slug":"luigi-montano","fullName":"Luigi Montano"},{"id":"222782","title":"Dr.","name":"Paolo","middleName":null,"surname":"Bergamo","slug":"paolo-bergamo","fullName":"Paolo Bergamo"},{"id":"222783","title":"Dr.","name":"Maria Grazia","middleName":null,"surname":"Andreassi","slug":"maria-grazia-andreassi","fullName":"Maria Grazia Andreassi"},{"id":"222784","title":"Dr.","name":"Stefano","middleName":null,"surname":"Lorenzetti","slug":"stefano-lorenzetti","fullName":"Stefano Lorenzetti"}]},{"id":"30215","doi":"10.5772\u002F39088","title":"﻿Mechanisms in Erectile Function and Dysfunction: An Overview","slug":"mechanisms-in-erectile-function-and-dysfunction-an-overview","totalDownloads":8674,"totalCrossrefCites":1,"totalDimensionsCites":26,"abstract":null,"isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"686","slug":"erectile-dysfunction-disease-associated-mechanisms-and-novel-insights-into-therapy","title":"Erectile Dysfunction","fullTitle":"Erectile Dysfunction - Disease-Associated Mechanisms and Novel Insights into Therapy","isOpenForSubmission":false,"isPublished":true},"signatures":"Kenia Pedrosa Nunes and R. Clinton Webb","authors":[{"id":"71405","title":"Dr.","name":"Kenia","middleName":"Pedrosa","surname":"Nunes","slug":"kenia-nunes","fullName":"Kenia Pedrosa Nunes"},{"id":"134106","title":"Dr.","name":"R. Clinton","middleName":null,"surname":"Webb","slug":"r.-clinton-webb","fullName":"R. Clinton Webb"}]},{"id":"45345","doi":"10.5772\u002F55200","title":"Role of Bacterial Biofilms in Catheter-Associated Urinary Tract Infections (CAUTI) and Strategies for Their Control","slug":"role-of-bacterial-biofilms-in-catheter-associated-urinary-tract-infections-cauti-and-strategies-for-","totalDownloads":3842,"totalCrossrefCites":10,"totalDimensionsCites":25,"abstract":null,"isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"3313","slug":"recent-advances-in-the-field-of-urinary-tract-infections","title":"Recent Advances in the Field of Urinary Tract Infections","fullTitle":"Recent Advances in the Field of Urinary Tract Infections","isOpenForSubmission":false,"isPublished":true},"signatures":"Mary Anne Roshni Amalaradjou and Kumar Venkitanarayanan","authors":[{"id":"61657","title":"Prof.","name":"Kumar","middleName":null,"surname":"Venkitanarayanan","slug":"kumar-venkitanarayanan","fullName":"Kumar Venkitanarayanan"},{"id":"158931","title":"Dr.","name":"Mary Anne Roshni","middleName":null,"surname":"Amalaradjou","slug":"mary-anne-roshni-amalaradjou","fullName":"Mary Anne Roshni Amalaradjou"}]}],"mostDownloadedChaptersLast30Days":[{"id":"83078","title":"Male Circumcision: History of Current Surgical Practice","slug":"male-circumcision-history-of-current-surgical-practice","totalDownloads":1207,"totalCrossrefCites":1,"totalDimensionsCites":2,"abstract":"One of the most frequent procedures carried out on men, whether for medical or religious reasons, is circumcision, which involves the removal of the foreskin. The procedure’s introduction in various locations and times allowed for the development of a surgical approach that is now adapted to minimize problems and deliver obvious medicinal benefits. Male circumcision is currently a hot topic of dispute because of ethical, legal, and scientific concerns, as well as the procedure’s various roles: therapeutic, preventive, and ritualistic. The practice’s origins can be traced back to ancient times, but it is still a surgical procedure used to prevent HIV transmission today. In order to lower the risk of HIV transmission in men, the WHO advised considering male circumcision in 2007. The purpose of this article is to describe the procedure of circumcision throughout history.","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"11729","slug":"circumcision-advances-and-new-perspectives","title":"Circumcision","fullTitle":"Circumcision - Advances and New Perspectives","isOpenForSubmission":false,"isPublished":true},"signatures":"Claudio Militello and Veronica Pais","authors":[{"id":"458797","title":"Dr.","name":"Claudio","middleName":null,"surname":"Militello","slug":"claudio-militello","fullName":"Claudio Militello"},{"id":"475927","title":"Ms.","name":"Veronica","middleName":null,"surname":"Pais","slug":"veronica-pais","fullName":"Veronica Pais"}]},{"id":"78480","title":"Methods of Sperm Selection for In-Vitro Fertilization","slug":"methods-of-sperm-selection-for-in-vitro-fertilization-1","totalDownloads":3124,"totalCrossrefCites":0,"totalDimensionsCites":0,"abstract":"50–60% of infertility cases are as a result of male infertility and infertile men semen sample is characterize with poor motility, abnormal morphology, low sperm concentration, azoospermic and increased levels of sperm DNA damage. As a result of this heterogeneity of the ejaculate, sperm selection has become a necessary step to carry out prior to in vitro fertilization. Furthermore, the choice of sperm cell selection techniques depend on sperm concentration and sperm biology and the recovery of highly functional sperm cell population depend on the combination of more than one technique in some cases. The regular sperm cell selection methods in ART laboratory are swim up, density gradient, simple wash and other advanced and emerging sperm selection techniques which include hyaluronic acid mediated sperm binding, Zeta potential, hypoosmotic swelling test, magnetic activated cell sorting and microfluidic separation of sperm cells. The various methods have its own advantages and disadvantages which may be applicable to the individual need of infertile men and its effect on ART outcome.","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"10724","slug":"male-reproductive-anatomy","title":"Male Reproductive Anatomy","fullTitle":"Male Reproductive Anatomy","isOpenForSubmission":false,"isPublished":true},"signatures":"Abimibola Nanna","authors":[{"id":"349382","title":"Mr.","name":"Abimibola","middleName":null,"surname":"Nanna","slug":"abimibola-nanna","fullName":"Abimibola Nanna"}]},{"id":"1175051","title":"Chronic Kidney Disease: Etiology, Pathophysiology, and Management Strategies to Increase Quality of Life","slug":null,"totalDownloads":2021,"totalCrossrefCites":3,"totalDimensionsCites":5,"abstract":"\u003Cp id=\"p1\"\u003EChronic kidney disease (CKD) refers to a variety of pathophysiologic conditions linked to poor kidney function and persistent reduction in glomerular filtration rate. According to the National Kidney Foundation&rsquo;s guidelines, CKD can be classified based on the amount of glomerular filtration rate. There are numerous etiologies for the occurrence of CKD. Various medications used to treat CKD will include slowing the progression, which is medical treatment, as well as employing natural products. Many strategies can be used to improve the quality of life of a CKD patient. This book chapter will further discuss etiology, pathophysiology, clinical manifestation, investigation, and management of patients in renal replacement therapy and also usage of medication to increase the quality of life.\u003C\u002Fp\u003E\n","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1003662","slug":null,"title":"Chronic Kidney Disease","fullTitle":"Chronic Kidney Disease - Novel Insights into Pathophysiology and Treatment","isOpenForSubmission":false,"isPublished":true},"signatures":"Kogila Supramanian, Mahendran Sekar and Nor Safwan Hadi Nor Afendi","authors":[{"id":"528655","title":"M.Sc.","name":"KOGILA","middleName":null,"surname":"SUPRAMANIAN","slug":"kogila-supramanian","fullName":"KOGILA SUPRAMANIAN"},{"id":"528658","title":"Associate Prof.","name":"Mahendran","middleName":null,"surname":"Sekar","slug":"mahendran-sekar","fullName":"Mahendran Sekar"},{"id":"543796","title":"Dr.","name":"Nor Safwan Hadi","middleName":null,"surname":"Nor Afendi","slug":"nor-safwan-hadi-nor-afendi","fullName":"Nor Safwan Hadi Nor Afendi"}]},{"id":"60974","title":"Techniques for Peritoneal Dialysis Catheter Placement","slug":"techniques-for-peritoneal-dialysis-catheter-placement","totalDownloads":2975,"totalCrossrefCites":0,"totalDimensionsCites":0,"abstract":"\n\u003Cp id=\"p1\"\u003EThis chapter describes the peritoneal dialysis (PD) catheter implantation techniques. It will also discuss the merits and demerits of each technique, catheter types as well as the PD catheter-related complications. Several techniques and modifications have been described for the insertion of the catheter into the abdominal cavity. We will describe the currently available catheter designs which come in a variety of shapes (straight, pigtail-curled, swan-neck), length and number of Dacron cuffs for optimal ingrowth and fixation and insertion techniques with its early and late complications. These techniques include open surgical, laparoscopic and percutaneous techniques. The strategy for an optimal catheter implantation together with the preventive and therapeutic means for complicated treatment will be discussed.\u003C\u002Fp\u003E\n\n","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"6537","slug":"evolving-strategies-in-peritoneal-dialysis","title":"Evolving Strategies in Peritoneal Dialysis","fullTitle":"Evolving Strategies in Peritoneal Dialysis","isOpenForSubmission":false,"isPublished":true},"signatures":"Stephen Akau Kache, Danjuma Sale and Jerry Godfrey Makama","authors":[{"id":"224451","title":"Dr.","name":"Stephen","middleName":null,"surname":"Kache","slug":"stephen-kache","fullName":"Stephen Kache"},{"id":"241440","title":"Dr.","name":"Danjuma","middleName":null,"surname":"Sale","slug":"danjuma-sale","fullName":"Danjuma Sale"},{"id":"251826","title":"Associate Prof.","name":"Jerry Godfrey","middleName":null,"surname":"Makama","slug":"jerry-godfrey-makama","fullName":"Jerry Godfrey Makama"}]},{"id":"79014","title":"Seminiferous Tubules and Spermatogenesis","slug":"seminiferous-tubules-and-spermatogenesis","totalDownloads":3335,"totalCrossrefCites":10,"totalDimensionsCites":20,"abstract":"One of the major concerns of the world health community is the infertility. The definition of infertility according to the World Health Organization (WHO) and the American Society for Reproductive Medicine (ASRM) is the inability of a healthy couple to achieve a conception after one year of regular, unprotected intercourse. Fertility complications affect seven percent of the male. The causes of infertility were divided to non-obstructive and obstructive. But, in almost 75% of male infertility cases are idiopathic with predominance of the genetic abnormalities. Numerical or structural chromosomal abnormalities are considered as genetic abnormalities that occur during the meiotic division in spermatogenesis. These abnormalities get transferred to the Offspring, which affects the normal and even the artificial conception. In the human reproduction, sperm cells are considered as a delivery vehicle for the male genetic material packed in chromosomes, which are composed of nearly 2-meter Deoxyribonucleic acid (DNA) molecule and their packaging proteins. This chapter points to grant a summarized description of individual components of the male reproductive system: the seminiferous tubule and spermatogenesis. Here, we describe step by step the structure of the testis seminiferous tubule and what occurs inside these tubules like cell communication and germ cell development from spermatogonia until spermatozoon. This book chapter is very useful for the biologists and physicians working in Assisted reproduction field to understand the physiology and pathology of spermatogenesis.","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"10724","slug":"male-reproductive-anatomy","title":"Male Reproductive Anatomy","fullTitle":"Male Reproductive Anatomy","isOpenForSubmission":false,"isPublished":true},"signatures":"Amor Houda, Shelko Nyaz, Bakry Mohamed Sobhy, Almandouh Hussein Bosilah, Micu Romeo, Jankowski Peter Michael and Hammadeh Mohamad Eid","authors":[{"id":"92657","title":"Dr.","name":"Mohamed Eid","middleName":null,"surname":"Hammadeh","slug":"mohamed-eid-hammadeh","fullName":"Mohamed Eid Hammadeh"},{"id":"337019","title":"Dr.","name":"Houda","middleName":null,"surname":"Amor","slug":"houda-amor","fullName":"Houda Amor"},{"id":"337221","title":"Dr.","name":"Nyaz","middleName":null,"surname":"Shelko","slug":"nyaz-shelko","fullName":"Nyaz Shelko"},{"id":"345468","title":"Dr.","name":"Peter Michael","middleName":null,"surname":"Jankowski","slug":"peter-michael-jankowski","fullName":"Peter Michael Jankowski"},{"id":"419473","title":"Dr.","name":"Bakry Mohamed Sobhy","middleName":null,"surname":"Sobhy","slug":"bakry-mohamed-sobhy-sobhy","fullName":"Bakry Mohamed Sobhy Sobhy"},{"id":"419475","title":"Dr.","name":"Almandouh Hussein","middleName":null,"surname":"Bosilah","slug":"almandouh-hussein-bosilah","fullName":"Almandouh Hussein Bosilah"},{"id":"419476","title":"Dr.","name":"Micu","middleName":null,"surname":"Romeo","slug":"micu-romeo","fullName":"Micu Romeo"}]}],"onlineFirstChaptersFilter":{"topicId":"204","limit":6,"offset":0},"onlineFirstChaptersCollection":[{"id":"1249701","title":"Urinary Tract Reconstruction in Renal Transplantation: From Primary Implantation to Complex Salvage","slug":null,"totalDownloads":6,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1016138","abstract":"\u003Cp\u003EUrinary tract reconstruction is an indispensable component of every renal transplantation (RT). At primary implantation, the surgeon must create a watertight, reliable, anti-refluxing anastomosis between the donor ureter and the recipient urinary tract; when urological complications develop &ndash; chiefly leaks and strictures, occurring in 2&ndash;5% of recipients &ndash; the same reconstructive repertoire must be redeployed in a hostile operative field to salvage graft function. This chapter presents a technique- and anatomy-oriented overview of urinary tract reconstruction in RT, organized by anastomotic target: bladder-level procedures (extravesical Lich&ndash;Gregoir and transvesical Leadbetter&ndash;Politano ureteroneocystostomy, psoas hitch, Boari flap and pyelovesicostomy); upper-tract procedures involving the native ureter or pelvis (pyelopyelostomy, pyeloureterostomy and ureteroureterostomy); and bowel-based reconstructions for complex cases (ileal ureter, conduit-based implantation). For each technique we outline indications in primary implantation and in salvage, key operative steps, reported outcomes, and pitfalls. Intraoperative considerations relevant to all reconstructions are discussed, including donor ureter handling, preservation of the periureteric &ldquo;golden triangle&rdquo; blood supply, the evidence base for prophylactic ureteric stenting, and the adaptation of classical techniques to minimally invasive and robotic platforms. A clinical decision algorithm is proposed for selecting among reconstructive options. A working knowledge of the entire reconstructive armamentarium allows the transplant surgeon to tailor both initial implantation and complication salvage to recipient anatomy and resource availability.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005499","title":"Updates on Kidney Transplantation","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000MQegpIAD\u002F0017403_TrikoderCover%20%282025-10-15%2012%3A59%3A52%29.jpg","isOpenForSubmission":false,"isPublished":false},"signatures":"Dorin Novacescu, Silviu Latcu, Cristi Tarta, Talida Georgiana Cut, Alexandra Herlo, Alin Cumpanas"},{"id":"1251056","title":"Surgical Complexities and Challenges in Renal Transplantation Urinary Tract Reconstruction in Transplant Recipients","slug":null,"totalDownloads":11,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1016140","abstract":"\u003Cp\u003EEnd-stage renal disease frequently coexists with complex urinary tract diseases and malformations. Some of the transplant candidates have undergone prior urinary tract reconstruction, including ileal conduits, orthotopic neobladders, continent cutaneous urinary diversions, and augmentation cystoplasty, most often for malignancy, neurogenic bladder, congenital anomalies, or traumatic injuries. Some of the patients will require urinary tract reconstruction surgeries after kidney transplantation due to posttransplant surgical complications. In such patients, highly complex reconstructive surgeries are indicated to save the graft and keep the patient out of dialysis. For many years, an abnormal or noncompliant lower urinary tract was a relative contraindication to renal transplantation. However, advances in urological reconstruction and transplant surgery have broadened the indications for kidney transplantation in this population. Several case series and cohort studies suggest that kidney transplantation into reconstructed urinary tracts can achieve acceptable graft and patient survival, but these procedures are technically demanding and associated with specific urological, infectious, and metabolic risks. Despite the growing clinical experience, there is no consensus on optimal pretransplant evaluation, timing of reconstruction relative to transplantation, or preferred surgical techniques. The objective of this chapter will therefore be to: Systematically review the literature on kidney transplantation in patients with reconstructed urinary tracts, summarizing graft and patient survival and procedure-specific complications; describe reported surgical techniques and perioperative strategies, including differences between diversion types and age groups; and present case series from our institution, illustrating practical aspects of preoperative assessment, operative management, and postoperative outcomes in this complex population.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005499","title":"Updates on Kidney Transplantation","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000MQegpIAD\u002F0017403_TrikoderCover%20%282025-10-15%2012%3A59%3A52%29.jpg","isOpenForSubmission":false,"isPublished":false},"signatures":"Archil Chkhotua"},{"id":"1241725","title":"Home Hemodialysis: An Individualized Approach to Renal Replacement Therapy","slug":null,"totalDownloads":6,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1016413","abstract":"\u003Cp\u003EConventional thrice-weekly hemodialysis, although lifesaving, is associated with high morbidity, mortality, and significant impairment in quality of life. Recent studies have demonstrated that longer and more frequent dialysis sessions improve solute clearance, stabilize volume control and reduce cardiovascular risk; however, evidence for survival benefits is largely derived from observational studies. The most suitable environment for implementing such intensive regimens is home hemodialysis, which offers patients flexibility, autonomy, and improved adherence. Historically, home hemodialysis was widely practiced during the 1960s&ndash;1980s, later declined due to technological and policy changes, but has regained attention since the 2010s with portable devices and evidence of clinical benefits. Current prevalence of home hemodialysis varies across countries, with the highest rates reported in Australia and New Zealand. In addition, new programs have recently been initiated in developing countries, reflecting a growing global interest in this modality. There are no randomized controlled trials specifically designed to evaluate mortality outcomes in patients undergoing home hemodialysis. The available evidence is derived primarily from observational studies, which generally suggest an association with improved survival, cardiovascular outcomes, and enhanced quality of life compared with conventional in-center hemodialysis. Risks include vascular access complications, accelerated loss of residual kidney function, and patient or caregiver burnout. Nevertheless, safety data suggest that major complications are rare. Home hemodialysis appears to be a clinically effective, generally safe, and economically favorable treatment option. Its broader global adoption will likely depend on coordinated efforts among healthcare authorities, policymakers, and patients to ensure long-term implementation and equitable accessibility.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005224","title":"Advances in Hemodialysis","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000IBw1hIAD\u002F0017128_TrikoderCover%20%282025-06-20%2014%3A46%3A45%29.jpg","isOpenForSubmission":false,"isPublished":false},"signatures":"Meltem Seziş and Cenk Demirci"},{"id":"1258230","title":"Management of Ureteral Complications After Kidney Transplantation","slug":null,"totalDownloads":17,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1016748","abstract":"\u003Cp\u003EUreteral complications (UC) after kidney transplantation (KT) are relatively uncommon, but their clinical impact is more significant than their frequency. Delayed diagnosis may impair graft function and, in severe cases, may result in graft loss. Most clinically significant complications are related to the anatomical and vascular vulnerability of the transplant ureter. During procurement, the ureter loses its native collateral circulation and becomes dependent on small hilar and peripelvic vessels. This explains the close relationship between early urinary leakage, ureteral necrosis, and later ischemic stricture. Prevention is, therefore, the main principle of management. It depends on careful preservation of periureteral tissue, avoiding excessive ureteral length or tension, appropriate selection of ureteroneocystostomy technique, and prophylactic stenting when needed. Diagnosis should be prompt and structured. Clinical suspicion, biochemical analysis of drain or aspirated fluid, ultrasonography, cross-sectional imaging, and selective antegrade or retrograde studies are used together. Management should be individualized according to timing, location, severity, graft function, infection, bladder condition, and available reconstructive options. Low-volume leaks and selected short strictures may be treated with urinary diversion, drainage, stenting, or endourological intervention. However, extensive necrosis, recurrent obstruction, long strictures, or failed minimally invasive treatment require surgical reconstruction. Native ureter-based reconstruction remains an important graft-sparing option. Vesicoureteral reflux should be managed according to its clinical consequences rather than radiological presence alone. Long-term surveillance is essential, especially after leak, stricture treatment, or reconstruction, to maintain durable urinary drainage and protect graft survival.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005499","title":"Updates on Kidney Transplantation","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000MQegpIAD\u002F0017403_TrikoderCover%20%282025-10-15%2012%3A59%3A52%29.jpg","isOpenForSubmission":false,"isPublished":false},"signatures":"Kadir Cem Günay and İbrahim Halil Baloğlu"},{"id":"1246777","title":"Testosterone in Males with Type 2 Diabetes","slug":null,"totalDownloads":10,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1015460","abstract":"\u003Cp\u003ETestosterone is also known as a metabolic hormone, playing a crucial regulatory role in the metabolism of carbohydrates, fats, and proteins. The testosterone levels of adult male patients with type 2 diabetes are significantly reduced, which affects blood glucose control and insulin resistance. At the same time, poor blood glucose control can exacerbate testosterone deficiency. Various diabetes treatment regimens may have different effects on testosterone. In recent years, numerous clinical studies have confirmed that testosterone replacement therapy can effectively prevent and even reverse early-stage type 2 diabetes. Therefore, in this chapter, we will describe the relevant clinical evidence and mechanisms of the interaction between testosterone levels and blood glucose control.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005654","title":"Andrology - Current Progress and Clinical Challenges in Male Health","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000Ns9RYIAZ\u002F0017558_TrikoderCover%20%282025-12-03%2012%3A48%3A51%29.jpg","isOpenForSubmission":false,"isPublished":false},"signatures":"Yun Hu and Yan Xia"},{"id":"1249384","title":"Sexual Dysfunction After Prostate Cancer Treatment: Mechanisms, Trajectories and Contemporary Management Strategies","slug":null,"totalDownloads":13,"totalDimensionsCites":0,"doi":"10.5772\u002Fintechopen.1016305","abstract":"\u003Cp\u003EThis chapter provides a comprehensive and clinically oriented overview of sexual dysfunction following prostate cancer (PCa) treatment, addressing a critical survivorship issue that significantly affects the long-term quality of life for patients and their partners. The scope encompasses the full spectrum of sexual dysfunction beyond erectile dysfunction (ED) alone, including changes in libido, orgasmic disorders, climacturia, penile sensory alterations, penile shortening, and partner-related sexual concerns. Mechanistic pathways associated with different treatment modalities &mdash;radical prostatectomy (RP), radiotherapy, androgen deprivation therapy (ADT), and selected focal therapies&mdash;are discussed to contextualize functional outcomes. This chapter also reviews validated assessment tools and emphasizes the importance of baseline evaluation and pretreatment counseling. Contemporary management strategies, including penile rehabilitation protocols, pharmacologic and device-based therapies, and surgical solutions such as penile prosthesis implantation, are presented in a practical, algorithm-driven framework. Emerging concepts in survivorship care, multidisciplinary management, and personalized rehabilitation pathways are highlighted, with a forward-looking perspective on unmet needs and future research directions in sexual health after PCa treatment.\u003C\u002Fp\u003E","isPublished":false,"isOnlineFirst":true,"isDeactivated":null,"isDeactivated2":0,"deactCorrection":null,"book":{"id":"1005269","title":"Prostate Cancer and Prostatic Diseases - Leading Edge Developments","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000IC5TIIA1\u002F0017173_TrikoderCover%20%282025-06-20%2014%3A46%3A45%29.jpg","isOpenForSubmission":true,"isPublished":false},"signatures":"Ahmet Tevfik Albayrak"}],"onlineFirstChaptersTotal":13},"preDownload":{"success":null,"errors":{}},"subscriptionForm":{"success":null,"errors":{}},"aboutIntechopen":{},"privacyPolicy":{},"cookiePolicy":{},"recruitmentPrivacyNotice":{},"peerReviewing":{},"howOpenAccessPublishingWithIntechopenWorks":{},"sponsorshipBooks":{"sponsorshipBooks":[],"offset":8,"limit":8,"total":0},"allSeries":{"pteSeriesList":[],"lsSeriesList":[],"hsSeriesList":[],"sshSeriesList":[],"testimonialsList":[]},"series":{"item":{"id":"26","title":"Nanotechnology and Nanomaterials","doi":"10.5772\u002Fintechopen.107191","issn":"3029-0538","scope":"\u003Cdiv\u003E\n\tHumans face growing challenges in environmental sustainability. We need better materials, more effective devices, and higher computing power to conquer these challenges. Researchers have long explored the realm of science at the nanometer scale for developing novel problem-solving technologies. In the past decades, breakthroughs in multiscale computer simulation, novel hierarchical material and device structures, nanometrology, and new functionalities from interfacial and quantum size effects have enhanced our ability to utilize nanotechnology to solve real-world problems.\u003C\u002Fdiv\u003E\n\u003Cdiv\u003E\n\tThis book series addresses important advancements in nanotechnology and nanomaterials. It showcases how nanotechnology is being continually developed and implemented in a variety of domains of science and technology. The two main topics this series covers are Nanotechnology and Nanodevices, and Nanomaterials and Nanostructures.\u003C\u002Fdiv\u003E","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries\u002Fcovers\u002F26.jpg","latestPublicationDate":"August 2nd, 2026","hasOnlineFirst":true,"numberOfPublishedBooks":16,"isWithoutTopics":false,"editor":{"id":"457620","title":"Emeritus Prof.","name":"Jung","middleName":null,"surname":"Huang","slug":"jung-huang","fullName":"Jung Huang","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F457620\u002F1772439323\u002Fprofile\u002Fimage1.jpg","biography":"Jung Y. Huang, a university educator and researcher, has been working to unravel the structures and functional properties of materials and cellular events in living cells with varying optical methodologies. He has co-authored hundreds of journal papers and five book chapters. He also holds tens of patents in laser techniques and single-molecule\u002Fhyperspectral imaging and has developed architectural photonics based on hierarchically structured materials. Currently, his research focuses on the integration of artificial intelligence methodology with optics to automatically discover meaningful information from optical sensing\u002Fimaging data cubes. He has been an editorial board member and reviewer for several scientific journals. As a member of the global scientific community, he sincerely supports and endeavors to promote the spread of scientific knowledge.","orcid":"0000-0002-4189-3779","institutionString":null,"institution":{"name":"National Chiao Tung University","institutionURL":"","country":{"name":"Taiwan"}}},"editorTwo":null,"editorThree":null},"editorialBoard":[],"subseries":{"paginationCount":2,"paginationItems":[{"id":"96","title":"Nanotechnology and Nanodevices","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries_topics\u002Fcovers\u002F96.jpg","editor":{"id":"52613","title":"Prof.","name":"Sadia","middleName":null,"surname":"Ameen","slug":"sadia-ameen","fullName":"Sadia Ameen","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F52613\u002F1779366101\u002Fprofile\u002Fimage1.png","biography":"Associate Professor Sadia Ameen serves at the Department of Bio-Convergence Sciences, Jeongeup Campus, Jeonbuk National University, Republic of Korea. She is also an Adjunct Professor in the Department of Bioactive Material Sciences at the Jeonju Campus of the same university and an Adjunct Visiting Associate Professor in the Department of Engineering, School of Computing, Engineering and Mathematical Sciences, La Trobe University, Australia. Her research is primarily focused on solar cells, including perovskite and organic solar cells, sensors, catalysts, and other optoelectronic devices. She has particular expertise in the synthesis and application of clean energy materials. Over the course of her career, she has received numerous honors, including a “Gold Medal for academic excellence”, the “Excellence in Research Award”, “Outstanding Scientist Award”, “Asia’s Top-50 Scientist Award”, “Certificate of Excellence”, and “Best Researcher Award”. She has been consistently listed among Stanford University’s World’s Top 2% Scientists. Associate Professor Ameen has authored and co-authored over 180 peer-reviewed publications, contributed to numerous book chapters, and edited 20 books. She also actively serves the scientific community as an editor and guest editor for various journals.","orcid":"0000-0001-7776-6539","institutionString":null,"institution":{"name":"Jeonbuk National University","institutionURL":null,"country":{"name":"Korea, South"}}},"editorTwo":{"id":"218191","title":"Dr.","name":"M. Shaheer","middleName":null,"surname":"Akhtar","slug":"m.-shaheer-akhtar","fullName":"M. Shaheer Akhtar","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F218191\u002F1773822386\u002Fprofile\u002Fimage1.jpg","biography":"Professor Dr. M. Shaheer Akhtar earned his Ph.D. in Chemical Engineering from Jeonbuk National University in the Republic of Korea. He is currently a Full Professor at the Graduate School of Integrated Energy-AI, Jeonbuk National University, and a Full Professor at the New & Renewable Energy Materials Development Center (NewREC) at the same university. He is also working as a Visiting Professor in the Department of Engineering at the School of Computing, Engineering and Mathematical Sciences, La Trobe University, Melbourne, Australia. His research interests focus on photo-electrochemical characterization of thin-film semiconductor nanomaterials, composite materials, polymer-based solid-state films, solid polymer electrolytes, electrode materials for hybrid organic–inorganic solar cells, small-molecule organic solar cells, supercapacitors, sensors, and lithium-ion batteries. Professor Akhtar is recognized for his contributions to nanotechnology research, with over 12,737 citations, h-index: 62, i10-index: 239 (Google Scholar: https:\u002F\u002Fscholar.google.com\u002Fcitations?user=Pu5pX-wAAAAJ&hl=en). He has consistently been ranked among the world’s Top 2% most highly cited scientists by Stanford University. In recognition of his scientific achievements, he has received international honors, including the “Outstanding 10 Years Contribution Award” from Jeonbuk National University, the “Outstanding Scientist Award (2021),” and the “International Distinguished Research Excellence Award (2022).”","orcid":"0000-0001-7698-2619","institutionString":null,"institution":{"name":"Jeonbuk National University","institutionURL":null,"country":{"name":"Korea, South"}}},"editorThree":{"id":"621405","title":"Dr.","name":"Ing","middleName":null,"surname":"Kong","slug":"ing-kong","fullName":"Ing Kong","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F621405\u002F1773822453\u002Fprofile\u002Fimage1.jpg","biography":"Ing Kong is a Full Professor in the Department of Engineering at La Trobe University. She is the Leader of the Advanced Polymer and Composites Group at the Bendigo campus. She has established her research expertise in additive manufacturing technology and the development of advanced materials, particularly functional polymer composites. Throughout her career, she has authored 114 publications and secured more than $6M in external grants. She has promoted interdisciplinary and joint research among research groups from national and international universities, as well as industry partners, including Ceramic Oxide Fabricators, Ritchie Technology, MoreDent, etc. She is serving as an editorial board member for several international scientific journals and as a peer reviewer for many materials and composites journals.","orcid":"0000-0001-7496-9728","institutionString":null,"institution":{"name":"La Trobe University","institutionURL":null,"country":{"name":"Australia"}}},"editorialBoard":[{"id":"328196","title":"Dr.","name":"Bikas C.","middleName":null,"surname":"Das","slug":"bikas-c.-das","fullName":"Bikas C. Das","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F328196\u002F1698222465\u002Fprofile\u002Fimage1.png","orcid":null,"institutionString":null,"institution":{"name":"Indian Institute of Science Education and Research Thiruvananthapuram","institutionURL":null,"country":{"name":"India"}}},{"id":"237300","title":"Dr.","name":"Juan Antonio","middleName":null,"surname":"Delgado Notario","slug":"juan-antonio-delgado-notario","fullName":"Juan Antonio Delgado Notario","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F237300\u002F1720617152\u002Fprofile\u002Fimage1.jpg","orcid":null,"institutionString":null,"institution":{"name":"Universidad de Salamanca","institutionURL":null,"country":{"name":"Spain"}}},{"id":"341836","title":"Prof.","name":"Norihiro","middleName":null,"surname":"Shimoi","slug":"norihiro-shimoi","fullName":"Norihiro Shimoi","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F341836\u002F1698044715\u002Fprofile\u002Fimage1.jpg","orcid":null,"institutionString":null,"institution":{"name":"Tohoku Institute of Technology","institutionURL":null,"country":{"name":"Japan"}}}],"associateEditorOne":null,"associateEditorTwo":null,"associateEditorThree":null,"_topicEditors":[{"id":"52613","title":"Prof.","name":"Sadia","middleName":null,"surname":"Ameen","slug":"sadia-ameen","fullName":"Sadia Ameen","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F52613\u002F1779366101\u002Fprofile\u002Fimage1.png","biography":"Associate Professor Sadia Ameen serves at the Department of Bio-Convergence Sciences, Jeongeup Campus, Jeonbuk National University, Republic of Korea. She is also an Adjunct Professor in the Department of Bioactive Material Sciences at the Jeonju Campus of the same university and an Adjunct Visiting Associate Professor in the Department of Engineering, School of Computing, Engineering and Mathematical Sciences, La Trobe University, Australia. Her research is primarily focused on solar cells, including perovskite and organic solar cells, sensors, catalysts, and other optoelectronic devices. She has particular expertise in the synthesis and application of clean energy materials. Over the course of her career, she has received numerous honors, including a “Gold Medal for academic excellence”, the “Excellence in Research Award”, “Outstanding Scientist Award”, “Asia’s Top-50 Scientist Award”, “Certificate of Excellence”, and “Best Researcher Award”. She has been consistently listed among Stanford University’s World’s Top 2% Scientists. Associate Professor Ameen has authored and co-authored over 180 peer-reviewed publications, contributed to numerous book chapters, and edited 20 books. She also actively serves the scientific community as an editor and guest editor for various journals.","orcid":"0000-0001-7776-6539","institutionString":null,"institution":{"name":"Jeonbuk National University","institutionURL":null,"country":{"name":"Korea, South"}}},{"id":"218191","title":"Dr.","name":"M. Shaheer","middleName":null,"surname":"Akhtar","slug":"m.-shaheer-akhtar","fullName":"M. Shaheer Akhtar","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F218191\u002F1773822386\u002Fprofile\u002Fimage1.jpg","biography":"Professor Dr. M. Shaheer Akhtar earned his Ph.D. in Chemical Engineering from Jeonbuk National University in the Republic of Korea. He is currently a Full Professor at the Graduate School of Integrated Energy-AI, Jeonbuk National University, and a Full Professor at the New & Renewable Energy Materials Development Center (NewREC) at the same university. He is also working as a Visiting Professor in the Department of Engineering at the School of Computing, Engineering and Mathematical Sciences, La Trobe University, Melbourne, Australia. His research interests focus on photo-electrochemical characterization of thin-film semiconductor nanomaterials, composite materials, polymer-based solid-state films, solid polymer electrolytes, electrode materials for hybrid organic–inorganic solar cells, small-molecule organic solar cells, supercapacitors, sensors, and lithium-ion batteries. Professor Akhtar is recognized for his contributions to nanotechnology research, with over 12,737 citations, h-index: 62, i10-index: 239 (Google Scholar: https:\u002F\u002Fscholar.google.com\u002Fcitations?user=Pu5pX-wAAAAJ&hl=en). He has consistently been ranked among the world’s Top 2% most highly cited scientists by Stanford University. In recognition of his scientific achievements, he has received international honors, including the “Outstanding 10 Years Contribution Award” from Jeonbuk National University, the “Outstanding Scientist Award (2021),” and the “International Distinguished Research Excellence Award (2022).”","orcid":"0000-0001-7698-2619","institutionString":null,"institution":{"name":"Jeonbuk National University","institutionURL":null,"country":{"name":"Korea, South"}}},{"id":"621405","title":"Dr.","name":"Ing","middleName":null,"surname":"Kong","slug":"ing-kong","fullName":"Ing Kong","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F621405\u002F1773822453\u002Fprofile\u002Fimage1.jpg","biography":"Ing Kong is a Full Professor in the Department of Engineering at La Trobe University. She is the Leader of the Advanced Polymer and Composites Group at the Bendigo campus. She has established her research expertise in additive manufacturing technology and the development of advanced materials, particularly functional polymer composites. Throughout her career, she has authored 114 publications and secured more than $6M in external grants. She has promoted interdisciplinary and joint research among research groups from national and international universities, as well as industry partners, including Ceramic Oxide Fabricators, Ritchie Technology, MoreDent, etc. She is serving as an editorial board member for several international scientific journals and as a peer reviewer for many materials and composites journals.","orcid":"0000-0001-7496-9728","institutionString":null,"institution":{"name":"La Trobe University","institutionURL":null,"country":{"name":"Australia"}}}],"_associateEditors":[]},{"id":"97","title":"Nanomaterials and Nanostructures","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries_topics\u002Fcovers\u002F97.jpg","editor":{"id":"89467","title":"Dr.","name":"Jose De Jesus","middleName":null,"surname":"Perez-Bueno","slug":"jose-de-jesus-perez-bueno","fullName":"Jose De Jesus Perez-Bueno","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F89467\u002F1776684271\u002Fprofile\u002Fimage1.jpg","biography":"José de Jesús Pérez Bueno, Ph.D. is Senior Researcher at the Centro de Investigación y Desarrollo Tecnológico en Electroquímica (CIDETEQ), Mexico. Born in 1973 in Zacatecas, Mexico, he earned his B.Sc. in Physics from the Autonomous University of Zacatecas, his M.Sc. in Physics from CINVESTAV-IPN, and his Ph.D. in Engineering (Materials) from the Autonomous University of Querétaro. He also completed postdoctoral research at the Institute of Polymer Technology and Materials Engineering, Loughborough University, United Kingdom, where he worked on organic-inorganic hybrid materials for optical waveguides. Since 2003, he has held a senior research position at CIDETEQ.\r\nDr. Pérez Bueno has developed an interdisciplinary research career spanning nanomaterials, electrochemical processes, sol-gel coatings, corrosion protection, photocatalysis, hybrid organic-inorganic materials, advanced composites, water treatment, solar-energy technologies, and sustainable materials engineering. His work has addressed both fundamental and applied problems, including inverse opal structures, functional coatings, electroless and electrolytic deposition, supercritical electrochemical processes, heavy-metal removal from water, solar concentrators, and recycling-based materials for environmental and industrial applications.\r\nHis publication record shows sustained scientific productivity over more than two decades (1998-2026), with contributions indexed in areas such as current nanotechnology, graphene oxide coatings, silicon-nanowire photocatalysis, corrosion-resistant systems, solar absorber materials, polymer recycling, and advanced functional surfaces. Recent publications listed in his CV extend through 2026, reflecting continued activity in nanotechnology, coatings, sustainable materials, and environmental applications.\r\nIn parallel with his research output, Dr. Pérez Bueno has maintained a strong record in technological development and knowledge transfer. His CV documents 12 granted patents and additional patent applications in areas including functional coatings, surface modification, antibacterial composite coatings, graphene-based materials, heavy-metal removal, and solar-assisted environmental technologies. He is also recognized in his country as SNII Level III researcher in Engineering for the 2024–2028 period.\r\nHis career is further distinguished by leadership in funded research projects, human-resource training, and innovation-oriented collaboration. He has led projects on nanostructured corrosion-protection materials, photonic and hybrid materials, supercritical electrochemical systems, solar concentrators, and environmental remediation technologies, and has received multiple distinctions, including doctoral thesis awards, the TECNOS Award, the PRODETES 2016 Silver Award, the Querétaro State Award for Science, Technology and Innovation (2022), and the Business Merit Award (2022).\r\nOverall, Dr. Pérez Bueno combines scientific depth, technological vision, editorial maturity, and a broad interdisciplinary perspective to serve as editor of a scholarly volume in nanotechnology.","orcid":"0000-0002-7775-405X","institutionString":null,"institution":{"name":"Center of Research and Technologic Development in Electrochemistry","institutionURL":null,"country":{"name":"Mexico"}}},"editorTwo":{"id":"1330794","title":"Dr.","name":"Maria Luisa","middleName":null,"surname":"Mendoza López","slug":"maria-luisa-mendoza-lopez","fullName":"Maria Luisa Mendoza López","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F1330794\u002F1776674034\u002Fprofile\u002Fimage1.jpg","biography":"María Luisa Mendoza López, Ph.D. was born in 1975 in Tláhuac, Mexico City, Mexico. She is currently Professor at the Instituto Tecnológico de Querétaro, where she teaches in the Mechanical Engineering and Materials Engineering programs. She received her Ph.D. in Materials Science from CINVESTAV-IPN, Querétaro Unit, in 2005, and her academic career has developed at the intersection of materials science, nanotechnology, environmental engineering, and technological innovation. Her research has focused on composite materials, functional and corrosion-resistant coatings, water treatment, material recycling, and applied nanotechnology. Over the course of her career, she has also worked on materials selection based on design and performance criteria, electrophoretic deposition of colloidal silica, sol-gel coatings, hybrid organic-inorganic composites based on polymer matrices, treatment of water contaminated with heavy metal ions, and inverse opal structures designed to maximize and control surface area for air and water depollution applications. This thematic range is consistent with her Scopus-indexed publication record, which shows sustained contributions in advanced materials, coatings, photocatalysis, corrosion, recycling, and sustainability-oriented engineering. Her publication profile reflects long-term scientific continuity together with clear interdisciplinary breadth. The organized Scopus file includes recent work in materials science and sustainability, such as studies on aluminum alloy modification, polymer waste recycling linked to the circular economy, and corrosion in construction materials, alongside earlier contributions in geopolymeric composites, photocatalytic nanostructures, and electroless and protective coatings. In addition to her research output, Dr. Mendoza López has contributed to thesis supervision, academic project development, professional training, and the strengthening of research and graduate education. Her trajectory combines scientific rigor, technological relevance, and a sustained commitment to applied research with environmental and industrial significance. These qualities, together with her broad perspective across materials processing, nanostructured systems, and sustainable technologies, make her especially well qualified to serve as editor of a scholarly volume in nanotechnology.","orcid":"0000-0002-3697-1875","institutionString":null,"institution":{"name":"Tecnológico Nacional de México","institutionURL":null,"country":{"name":"Mexico"}}},"editorThree":null,"editorialBoard":[{"id":"198180","title":"Dr.","name":"Maddalena","middleName":null,"surname":"Pedio","slug":"maddalena-pedio","fullName":"Maddalena Pedio","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F198180\u002F1679474634\u002Fprofile\u002Fimage1.jpg","orcid":null,"institutionString":null,"institution":{"name":"National Research Council","institutionURL":null,"country":{"name":"Italy"}}},{"id":"278962","title":"Dr.","name":"Mostapha","middleName":null,"surname":"Tarfaoui","slug":"mostapha-tarfaoui","fullName":"Mostapha Tarfaoui","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F278962\u002F1684935438\u002Fprofile\u002Fimage1.jpg","orcid":null,"institutionString":"ENSTA Bretagne IRDL UMR CNRS 6027, Brest, France","institution":null},{"id":"163154","title":"Dr.","name":"Sergio Alfonso","middleName":null,"surname":"Pérez García","slug":"sergio-alfonso-perez-garcia","fullName":"Sergio Alfonso Pérez García","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F163154\u002F1702548508\u002Fprofile\u002Fimage1.jpg","orcid":null,"institutionString":null,"institution":{"name":"Centro de Investigación en Materiales Avanzados","institutionURL":null,"country":{"name":"Mexico"}}}],"associateEditorOne":null,"associateEditorTwo":null,"associateEditorThree":null,"_topicEditors":[{"id":"89467","title":"Dr.","name":"Jose De Jesus","middleName":null,"surname":"Perez-Bueno","slug":"jose-de-jesus-perez-bueno","fullName":"Jose De Jesus Perez-Bueno","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F89467\u002F1776684271\u002Fprofile\u002Fimage1.jpg","biography":"José de Jesús Pérez Bueno, Ph.D. is Senior Researcher at the Centro de Investigación y Desarrollo Tecnológico en Electroquímica (CIDETEQ), Mexico. Born in 1973 in Zacatecas, Mexico, he earned his B.Sc. in Physics from the Autonomous University of Zacatecas, his M.Sc. in Physics from CINVESTAV-IPN, and his Ph.D. in Engineering (Materials) from the Autonomous University of Querétaro. He also completed postdoctoral research at the Institute of Polymer Technology and Materials Engineering, Loughborough University, United Kingdom, where he worked on organic-inorganic hybrid materials for optical waveguides. Since 2003, he has held a senior research position at CIDETEQ.\r\nDr. Pérez Bueno has developed an interdisciplinary research career spanning nanomaterials, electrochemical processes, sol-gel coatings, corrosion protection, photocatalysis, hybrid organic-inorganic materials, advanced composites, water treatment, solar-energy technologies, and sustainable materials engineering. His work has addressed both fundamental and applied problems, including inverse opal structures, functional coatings, electroless and electrolytic deposition, supercritical electrochemical processes, heavy-metal removal from water, solar concentrators, and recycling-based materials for environmental and industrial applications.\r\nHis publication record shows sustained scientific productivity over more than two decades (1998-2026), with contributions indexed in areas such as current nanotechnology, graphene oxide coatings, silicon-nanowire photocatalysis, corrosion-resistant systems, solar absorber materials, polymer recycling, and advanced functional surfaces. Recent publications listed in his CV extend through 2026, reflecting continued activity in nanotechnology, coatings, sustainable materials, and environmental applications.\r\nIn parallel with his research output, Dr. Pérez Bueno has maintained a strong record in technological development and knowledge transfer. His CV documents 12 granted patents and additional patent applications in areas including functional coatings, surface modification, antibacterial composite coatings, graphene-based materials, heavy-metal removal, and solar-assisted environmental technologies. He is also recognized in his country as SNII Level III researcher in Engineering for the 2024–2028 period.\r\nHis career is further distinguished by leadership in funded research projects, human-resource training, and innovation-oriented collaboration. He has led projects on nanostructured corrosion-protection materials, photonic and hybrid materials, supercritical electrochemical systems, solar concentrators, and environmental remediation technologies, and has received multiple distinctions, including doctoral thesis awards, the TECNOS Award, the PRODETES 2016 Silver Award, the Querétaro State Award for Science, Technology and Innovation (2022), and the Business Merit Award (2022).\r\nOverall, Dr. Pérez Bueno combines scientific depth, technological vision, editorial maturity, and a broad interdisciplinary perspective to serve as editor of a scholarly volume in nanotechnology.","orcid":"0000-0002-7775-405X","institutionString":null,"institution":{"name":"Center of Research and Technologic Development in Electrochemistry","institutionURL":null,"country":{"name":"Mexico"}}},{"id":"1330794","title":"Dr.","name":"Maria Luisa","middleName":null,"surname":"Mendoza López","slug":"maria-luisa-mendoza-lopez","fullName":"Maria Luisa Mendoza López","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F1330794\u002F1776674034\u002Fprofile\u002Fimage1.jpg","biography":"María Luisa Mendoza López, Ph.D. was born in 1975 in Tláhuac, Mexico City, Mexico. She is currently Professor at the Instituto Tecnológico de Querétaro, where she teaches in the Mechanical Engineering and Materials Engineering programs. She received her Ph.D. in Materials Science from CINVESTAV-IPN, Querétaro Unit, in 2005, and her academic career has developed at the intersection of materials science, nanotechnology, environmental engineering, and technological innovation. Her research has focused on composite materials, functional and corrosion-resistant coatings, water treatment, material recycling, and applied nanotechnology. Over the course of her career, she has also worked on materials selection based on design and performance criteria, electrophoretic deposition of colloidal silica, sol-gel coatings, hybrid organic-inorganic composites based on polymer matrices, treatment of water contaminated with heavy metal ions, and inverse opal structures designed to maximize and control surface area for air and water depollution applications. This thematic range is consistent with her Scopus-indexed publication record, which shows sustained contributions in advanced materials, coatings, photocatalysis, corrosion, recycling, and sustainability-oriented engineering. Her publication profile reflects long-term scientific continuity together with clear interdisciplinary breadth. The organized Scopus file includes recent work in materials science and sustainability, such as studies on aluminum alloy modification, polymer waste recycling linked to the circular economy, and corrosion in construction materials, alongside earlier contributions in geopolymeric composites, photocatalytic nanostructures, and electroless and protective coatings. In addition to her research output, Dr. Mendoza López has contributed to thesis supervision, academic project development, professional training, and the strengthening of research and graduate education. Her trajectory combines scientific rigor, technological relevance, and a sustained commitment to applied research with environmental and industrial significance. These qualities, together with her broad perspective across materials processing, nanostructured systems, and sustainable technologies, make her especially well qualified to serve as editor of a scholarly volume in nanotechnology.","orcid":"0000-0002-3697-1875","institutionString":null,"institution":{"name":"Tecnológico Nacional de México","institutionURL":null,"country":{"name":"Mexico"}}}],"_associateEditors":[]}]},"overviewPageOFChapters":{"paginationCount":16,"paginationItems":[{"id":"1241632","title":"From Cracks to Resilience: An Integrated Rehabilitation Method and Performance-Based Retrofitting of Reinforced Concrete Structures","doi":"10.5772\u002Fintechopen.1015085","signatures":"Ali Biglarifadafan and Su-Gwang Jeong","slug":null,"isPublished":false,"isOnlineFirst":true,"totalDownloads":11,"totalCrossrefCites":0,"totalDimensionsCites":null,"authors":[{"name":"Ali","surname":"Biglari"}],"book":{"title":"New Approaches in Reinforced Concrete","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000GddfMIAR\u002F0016993_TrikoderCover%20%282025-05-05%2012%3A00%3A55%29.jpg","subseries":{"id":"107","title":"Structural Engineering"}},"subseries":null},{"id":"1240888","title":"Revisiting Ekistics: Doxiadis’ Human Settlements Theory as a Framework for Sustainable Housing","doi":"10.5772\u002Fintechopen.1014774","signatures":"İmran Gümüş Battal","slug":null,"isPublished":false,"isOnlineFirst":true,"totalDownloads":13,"totalCrossrefCites":0,"totalDimensionsCites":0,"authors":[{"name":"Imran","surname":"Gumus Battal"}],"book":{"title":"Sustainable Housing Solutions - Economic, Social, and Environmental Strategies for Resilient Living ","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000GddfLIAR\u002F0016992_TrikoderCover%20%282025-05-05%2012%3A00%3A55%29.jpg","subseries":{"id":"108","title":"Construction Engineering"}},"subseries":null},{"id":"1248946","title":"Reconsidering Prefabrication: Renewable Nonbearing Partitions for Flexible and Adaptable Housing","doi":"10.5772\u002Fintechopen.1015974","signatures":"Yael Allweil, Merryan Majerowitz","slug":null,"isPublished":false,"isOnlineFirst":true,"totalDownloads":27,"totalCrossrefCites":0,"totalDimensionsCites":0,"authors":[{"name":"Yael","surname":"Allweil"},{"name":"Merryan","surname":"Majerowitz"}],"book":{"title":"Sustainable Housing Solutions - Economic, Social, and Environmental Strategies for Resilient Living ","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000GddfLIAR\u002F0016992_TrikoderCover%20%282025-05-05%2012%3A00%3A55%29.jpg","subseries":{"id":"108","title":"Construction Engineering"}},"subseries":null},{"id":"1245756","title":"Global Best Practices in Affordable Housing Policies: Lessons Learned from Developed and Emerging Countries","doi":"10.5772\u002Fintechopen.1016019","signatures":"Levent Sümer and Ali Hepşen","slug":null,"isPublished":false,"isOnlineFirst":true,"totalDownloads":56,"totalCrossrefCites":0,"totalDimensionsCites":0,"authors":[{"name":"Levent","surname":"Sumer"},{"name":"Ali","surname":"Hepsen"}],"book":{"title":"Sustainable Housing Solutions - Economic, Social, and Environmental Strategies for Resilient Living ","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000GddfLIAR\u002F0016992_TrikoderCover%20%282025-05-05%2012%3A00%3A55%29.jpg","subseries":{"id":"108","title":"Construction Engineering"}},"subseries":null}]},"overviewPagePublishedBooks":{"paginationCount":21,"paginationItems":[{"type":"book","id":"12058","title":"Future Housing","subtitle":null,"coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F12058.jpg","slug":"future-housing","isPublished":true,"publishedDate":"December 6th 2023","editedByType":"Edited by","bookSignature":"Alessandra Battisti","hash":"e7f4a1e57fab392b61156956c1247b9e","volumeInSeries":1,"fullTitle":"Future Housing","kuFlag":false,"editors":[{"id":"246098","title":"Dr.","name":"Alessandra","middleName":null,"surname":"Battisti","slug":"alessandra-battisti","fullName":"Alessandra Battisti","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F246098\u002F1734011559\u002Fprofile\u002Fimage1.jpg","biography":"Alessandra Battisti is a practicing architect and Full Professor of Environmental Design and Technology of Architecture at the School of Architecture, Sapienza University of Rome, Italy, where she oversees the master’s programs in Landscape Architecture and Architecture-Urban Regeneration. She is also the director of the level-II master’s program in the Valorization and Enhancement of Small Historical Centers. She is on the faculty board and teaching staff of the Ph.D. in Environmental Design and Planning. She is an expert consultant for the European community, the Italian Ministry of Universities and Research, and the Italian Ministry of Culture. She has published more than 200 scientific publications and 14 books. She is the winner of more than thirty international architectural competitions.","institutionString":null,"institution":{"name":"Sapienza University of Rome","institutionURL":null,"country":{"name":"Italy"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"12626","title":"Risk Management in Construction","subtitle":"Recent Advances","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F12626.jpg","slug":"risk-management-in-construction-recent-advances","isPublished":true,"publishedDate":"January 10th 2024","editedByType":"Edited by","bookSignature":"Hasan Tosun, Necmi Gürsakal and Asli Sebatli-Saglam","hash":"42f193eadc5db7dd2063e073a3ea07cd","volumeInSeries":2,"fullTitle":"Risk Management in Construction - Recent Advances","kuFlag":false,"editors":[{"id":"79083","title":"Dr.","name":"Hasan","middleName":null,"surname":"Tosun","slug":"hasan-tosun","fullName":"Hasan Tosun","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F79083\u002F1783402873\u002Fprofile\u002Fimage1.png","biography":"Hasan Tosun is a full professor in Hydrotechnical Engineering. He had a BS, an MS, and a PhD from Middle East Technical University in Ankara, Türkiye, and started his professional career by working at the General Directorate of State Hydraulic Works in 1979. Up to 1997, he worked at the General Directorate of State Hydraulic Works and supervised the geotechnical studies of large dams constructed in the country. Then he transferred to the Civil Engineering Department of the Faculty of Engineering and Architecture, Osmangazi University, Eskisehir. He has served as director of the Earthquake Research Center for 12 years, dean of the Engineering Faculty for 5 years, vice rector of the University for 2 years, and rector of the University for 2 years. He specializes in geotechnics for embankment dams, especially for the stability of embankment dams under static and dynamic loading conditions. He teaches the courses of Soil Mechanics, Geotechnics for Dam Engineering, Measurements of Soil Properties, and Engineering Geology at the University. He, who has over 350 technical papers published in national and international journals and in conferences, congresses, and symposiums, is the author of four books on soil mechanics and geotechnics for dams, and edited six international books and special issues of journals. Currently, he is the president of the Turkish Society of Dam Safety, a member of the National Societies of Soil Mechanics and Foundation Engineering, Rock Mechanics, and Engineering Geology. He has international memberships for CDA in Canada and for USSD and ASSDO in the USA.","institutionString":null,"institution":{"name":"Eskişehir Osmangazi University","institutionURL":"","country":{"name":"Turkey"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"13193","title":"Façade Design","subtitle":"Challenges and Future Perspective","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F13193.jpg","slug":"fa-ade-design-challenges-and-future-perspective","isPublished":true,"publishedDate":"January 24th 2024","editedByType":"Edited by","bookSignature":"Chiara Bedon, Marcin Kozlowski and Mislav Stepinac","hash":"032bfd0e0dac47079fb13b92469bc5cb","volumeInSeries":4,"fullTitle":"Façade Design - Challenges and Future Perspective","kuFlag":false,"editors":[{"id":"533247","title":"Prof.","name":"Chiara","middleName":null,"surname":"Bedon","slug":"chiara-bedon","fullName":"Chiara Bedon","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F533247\u002F1759755027\u002Fprofile\u002Fimage1.jpg","biography":"Chiara Bedon is an Associate Professor at the University of Trieste, Department of Engineering and Architecture, in Italy, where she's the principal instructor for 'Structural Analysis', 'Steel Structures', and 'Seismic Resistant Structures'. She is actively involved in international research projects and networks (JRC-ERNCIP, NATO-SPS, COST, etc.) with a primary focus on structural systems, extreme design actions, steel and glass, and is a member of national and international boards in charge of the elaboration of design standards. Listed as a \"Top 2% Scientist\" by Stanford and a \"Top Italian Woman Scientist\" in engineering, she has received several research grants for young scientists. She is the principal investigator for several projects, which have received funding of up to 1.7 million euros in recent years.","institutionString":null,"institution":{"name":"University of Trieste","institutionURL":null,"country":{"name":"Italy"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"12280","title":"New Research on Railway Engineering and Transportation","subtitle":null,"coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F12280.jpg","slug":"new-research-on-railway-engineering-and-transportation","isPublished":true,"publishedDate":"January 24th 2024","editedByType":"Edited by","bookSignature":"Ali G. Hessami and Roderick Muttram","hash":"6da96f4a0f65ed41591ee0344289308e","volumeInSeries":3,"fullTitle":"New Research on Railway Engineering and Transportation","kuFlag":false,"editors":[{"id":"108303","title":"Prof.","name":"Ali G.","middleName":null,"surname":"Hessami","slug":"ali-g.-hessami","fullName":"Ali G. Hessami","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F108303\u002F1706048157\u002Fprofile\u002Fimage1.jpg","biography":"Ali Hessami is currently Director of R&D and Innovation at Vega Systems and a UK expert on the European Committee for Electrotechnical Standardization (CENELEC) and International Electrotechnical Commission (IEC) systems, hardware and software safety, and security standards. He chaired the Institute of Electronic and Electrical Engineers (IEE) 7000 standard “Addressing Ethical Concerns in System Design” and was later appointed as the VC and process architect of IEEE’s Certification Program for Autonomous and Intelligent Systems (CertifAIEd). He also chairs BSI’s GEL\u002F9\u002F6 subcommittee focused on machine learning (ML), artificial intelligence (AI), and cybersecurity standardization in railways. He is a visiting professor at London City University’s Centre for Systems and Control and at Beijing Jiaotong University, China. He is also a fellow of the Royal Society of Arts (RSA) and the UK Institution of Engineering and Technology (IET), as well as a life senior member of the IEEE.","institutionString":"Vega Systems","institution":{"name":"City, University of London","institutionURL":null,"country":{"name":"United Kingdom"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}}]},"openForSubmissionBooks":{"paginationCount":1,"paginationItems":[{"id":"1005544","title":"Weight Management - Beyond Weight Loss","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000MQehYIAT\u002F0017448_TrikoderCover%20%282025-10-15%2013%3A17%3A21%29.jpg","hash":"a19364bffaf92189fd1f2801edad0c4b","secondStepPassed":false,"currentStepOfPublishingProcess":2,"submissionDeadline":"August 28th 2026","isOpenForSubmission":true,"isPublished":false,"kuFlag":false,"editors":[{"id":"182103","title":"Prof.","name":"Dana Liana","surname":"Stoian","slug":"dana-liana-stoian","fullName":"Dana Liana Stoian"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}}]},"onlineFirstChapters":{"paginationCount":42,"paginationItems":[{"id":"1247277","title":"B-Complex Vitamins: Dietary Sources, Biosynthesis, Health Applications and Emerging Therapeutic Perspectives","doi":"10.5772\u002Fintechopen.1016034","signatures":"Ajit Kumar Dhal, Joel Kiran George and Manisha Raparthi","slug":null,"totalDownloads":8,"totalCrossrefCites":null,"totalDimensionsCites":null,"isPublished":false,"isOnlineFirst":