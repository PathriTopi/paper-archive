ublished":true,"bookSignature":"Vladimir Pletser","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F10445.jpg","numberOfDownloads":15771,"numberOfWosCitations":0,"numberOfTotalCitations":73,"numberOfCrossrefCitations":29,"numberOfDimensionsCitations":44,"kuFlag":false,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F10445\u002F1718117670-1987883555\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F10445\u002F1718117670-1987883555\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F10445\u002F1718280072-399735011\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F10445\u002F1718280072-399735011\u002Fweb-cover-300.jpg","editors":[{"id":"320503","title":"Dr.","name":"Vladimir","middleName":null,"surname":"Pletser","slug":"vladimir-pletser","fullName":"Vladimir Pletser"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter"}},{"type":"book","id":"1004790","title":"Technology, Cultural Heritage and Scientific Diplomacy","subtitle":null,"fullTitle":"Technology, Cultural Heritage and Scientific Diplomacy","isOpenForSubmission":false,"hash":"65ba2898ed4f68d3f5f4849be5259774","slug":null,"isPublished":true,"bookSignature":"Sabrina Greco, Maurizio Lazzari and Jorge Carlos Naranjo Alcaide","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000CCwFsIAL\u002F0016694_TrikoderCover%20%282026-04-07%2012%3A21%3A51%29.jpg","numberOfDownloads":206,"numberOfWosCitations":null,"numberOfTotalCitations":0,"numberOfCrossrefCitations":0,"numberOfDimensionsCitations":0,"kuFlag":false,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004790\u002F1783409919-104542831\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004790\u002F1783409919-104542831\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004790\u002F1775121821-309036756\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004790\u002F1775121821-309036756\u002Fweb-cover-300.jpg","editors":[{"id":"636161","title":"Dr.","name":"Sabrina","middleName":null,"surname":"Greco","slug":"sabrina-greco","fullName":"Sabrina Greco"}],"equalEditorOne":{"id":"250931","title":"Dr.","name":"Maurizio","middleName":null,"surname":"Lazzari","slug":"maurizio-lazzari","fullName":"Maurizio Lazzari","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F250931\u002F1771498298\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Maurizio Lazzari has a PhD in Earth Science and is a researcher at the Italian National Research Council, Institute of Cultural Heritage Sciences. Since 2001, Dr. Lazzari has been a Professor of Pedology at the University of Basilicata (Italy) and a geoarchaeologist at the University of Salento (Italy). His research activities are focused on natural and anthropic hazards and risk factors, aimed at safeguarding and conserving settlements and the historical–monumental heritage of the Mediterranean, with particular attention to landslide processes, susceptibility maps, monitoring, and modelling.\r\nSince 2004, he has been working as a scientific coordinator for several national research projects studying landslides and triggering factors, natural and anthropogenic risks, geological and geomorphological mapping, soil erosion, preservation of historical and archaeological sites, enhancement of degraded areas, geo-touristic use, and the protection of the landscapes.\r\nHe is the author of about 150 scientific publications in national and international journals, monographs, book chapters, and conference proceedings concerning applied geology, geomorphology, dynamics of artificial reservoirs, soil erosion, landslides, geoarchaeology, hydrogeological instability, natural hazards, monitoring, cultural landscape, UNESCO Heritage, geoarchaeology, and geo-tourism.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"5","totalChapterViews":"0","totalEditedBooks":"2","institution":{"name":"National Research Council","institutionURL":null,"country":{"name":"Italy"}}},"equalEditorTwo":{"id":"652430","title":"Dr.","name":"Jorge Carlos","middleName":null,"surname":"Naranjo Alcaide","slug":"jorge-carlos-naranjo-alcaide","fullName":"Jorge Carlos Naranjo Alcaide","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F652430\u002F1775549009\u002Fprofile\u002Fimage1.jpg","biography":"Jorge Carlos Naranjo Alcaide was born in Madrid (Spain) in 1974. He is a Comboni Missionary who has worked in Sudan since 2008. He has been the Principal of CCST since 2012. He holds a PhD in Total Quality Management from the Sudan University of Science and Technology, Deanship of Quality and Development, and a Master\\'s Degree in Direction and Quality Management of Educational Centres. \nHe is one of the founders of C-Hub Limited Company, an incubator that supports the creation of digital start-ups by Sudanese and refugee young people in Sudan, as well as the national committee of ICOMOS Sudan.","institutionString":"Comboni College of Science and Technology, Sudan","position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"3","totalChapterViews":"0","totalEditedBooks":"1","institution":null},"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"4","chapterContentType":"chapter"}},{"type":"book","id":"1003912","title":"Climate Policies","subtitle":"Modern Risk-Based Assessment of Investments in Mitigation, Adaptation, and Recovery from Residual Harm","fullTitle":"Climate Policies - Modern Risk-Based Assessment of Investments in Mitigation, Adaptation, and Recovery from Residual Harm","isOpenForSubmission":false,"hash":"06c9639739cc7645b81d020f9693a339","slug":null,"isPublished":true,"bookSignature":"Gary Yohe and Joel Smith","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa043Y000011YN2FQAW\u002F0015816_TrikoderCover%20%282023-10-30%2008%3A04%3A07%29.jpg","numberOfDownloads":1497,"numberOfWosCitations":null,"numberOfTotalCitations":13,"numberOfCrossrefCitations":5,"numberOfDimensionsCitations":8,"kuFlag":true,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003912\u002F1776415693-1565590675\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003912\u002F1776415693-1565590675\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003912\u002F1744353931-2131354844\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003912\u002F1744353931-2131354844\u002Fweb-cover-300.jpg","editors":[{"id":"323870","title":"Emeritus Prof.","name":"Gary","middleName":null,"surname":"Yohe","slug":"gary-yohe","fullName":"Gary Yohe"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"624164","title":"Mr.","name":"Joel","middleName":null,"surname":"Smith","slug":"joel-smith","fullName":"Joel Smith","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F624164\u002F1744619099\u002Fprofile\u002Fimage1.png","biography":"Joel B. Smith is an expert with over 35 years of experience researching climate change vulnerability and adaptation. He led the first national assessment of climate change impacts, the U.S. Environmental Protection Agency study of climate change impacts in the late 1980s, and the first global assessment of climate change impacts, published by Cambridge University Press in 1995. He served twice as a Coordinating Lead Author for the Intergovernmental Panel on Climate Change, where he conceived of and led the development of the synthesis of climate change impacts (a.k.a., “Burning Embers”), which has been updated in subsequent IPCC reports. He has published more than 70 journal articles, edited books, and book chapters, and written two dozen reports for government and research organizations on climate change vulnerability. Mr. Smith worked for EPA and has been a consultant for most of his career. He taught at Universities on climate change and serves on several advisory boards to the U.S. government and the United Nations.","institutionString":"Independent Researcher, USA","position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"0","totalChapterViews":"0","totalEditedBooks":"1","institution":null,"countryString":null},"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter"}},{"type":"book","id":"1003597","title":"Towards the Eradication of \u003Cem\u003EHelicobacter pylori\u003C\u002Fem\u003E Infection","subtitle":"Rapid Diagnosis and Precision Treatment","fullTitle":"Towards the Eradication of Helicobacter pylori Infection - Rapid Diagnosis and Precision Treatment","isOpenForSubmission":false,"hash":"ec8f1cefa934caf4aae4e70b7b39d9e4","slug":null,"isPublished":true,"bookSignature":"Liang Wang, Alfred Chin Yen Tay and Barry J. Marshall","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa043Y000010M8cRQAS\u002F0015501_TrikoderCover%20%282023-05-18%2007%3A08%3A50%29.jpg","numberOfDownloads":2690,"numberOfWosCitations":null,"numberOfTotalCitations":7,"numberOfCrossrefCitations":3,"numberOfDimensionsCitations":4,"kuFlag":false,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003597\u002F1744021525-609452403\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003597\u002F1744021525-609452403\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003597\u002F1721026978-111936806\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1003597\u002F1721026978-111936806\u002Fweb-cover-300.jpg","editors":[{"id":"510963","title":"Prof.","name":"Liang","middleName":null,"surname":"Wang","slug":"liang-wang","fullName":"Liang Wang"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"543956","title":"Dr.","name":"Alfred Chin Yen","middleName":null,"surname":"Tay","slug":"alfred-chin-yen-tay","fullName":"Alfred Chin Yen Tay","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F543956\u002F1715777923\u002Fprofile\u002Fimage1.png","biography":"Alfred Chin Yen Tay is a leading researcher in H. pylori epidemiology, studying Helicobacter diversity in humans and animals through genomic analysis. His work at the Helicobacter Research Laboratory in the UWA Marshall Centre for Infectious Diseases Research and Training focuses on developing new diagnostic tools for Helicobacter infection. Dr. Tay’s studies on H. pylori antibiotic resistance have led to improved diagnostics and personalized treatments, achieving a 90% cure rate for resistant cases. He also founded the Helicobacter Fellowship Training Program, supported by the Australia Department of Foreign Affairs and Trading (DFAT), to enhance H. pylori research in developing countries. Dr. Tay is passionate about reducing the global gastric cancer rate by supporting local H. pylori research in these nations.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"0","totalChapterViews":"0","totalEditedBooks":"1","institution":{"name":"University of Western Australia","institutionURL":"","country":{"name":"Australia"}},"countryString":null},"coeditorTwo":{"id":"543958","title":"Prof.","name":"Barry J.","middleName":null,"surname":"Marshall","slug":"barry-j.-marshall","fullName":"Barry J. Marshall","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F543958\u002F1734031032\u002Fprofile\u002Fimage1.png","biography":"Barry J. Marshall has managed a Helicobacter pylori research group almost since he discovered Helicobacter pylori with Robin Warren in 1982. Prof. Marshall received many honors for his work on Helicobacter pylori, most notably the Nobel Prize for Medicine or Physiology in 2005. In the past few years, Prof. Marshall’s laboratory has developed enhanced methods for noninvasive studies on the molecular epidemiology of H. pylori, notably a rapid breath test and retrieval of the organism (and culture) from a swallowed string. Prof. Marshall has recently succeeded in drawing investor funding from international and national sources for the creation of Ondek, a small biotech company focused on developing new biologic delivery systems for vaccines and therapeutics, utilizing genetically modified Helicobacter pylori.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"0","totalChapterViews":"0","totalEditedBooks":"1","institution":{"name":"University of Western Australia","institutionURL":"","country":{"name":"Australia"}},"countryString":null},"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter"}},{"type":"book","id":"1004767","title":"Sustainable Crop Management","subtitle":"Programs, Research and Future Pathways","fullTitle":"Sustainable Crop Management - Programs, Research and Future Pathways","isOpenForSubmission":false,"hash":"f1f327d60973f9b980e5f56e68f76d42","slug":null,"isPublished":true,"bookSignature":"Michael Aide, Indi Braden, Shakirah Nakasagga, António M. Jordão and Ana Cristina Correia","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000BcX3XIAV\u002F0016671_TrikoderCover%20%282024-11-05%2011%3A35%3A13%29.jpg","numberOfDownloads":1463,"numberOfWosCitations":null,"numberOfTotalCitations":12,"numberOfCrossrefCitations":4,"numberOfDimensionsCitations":8,"kuFlag":false,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004767\u002F1786438309-1792599010\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004767\u002F1786438309-1792599010\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004767\u002F1784555089-1730214867\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F1004767\u002F1784555089-1730214867\u002Fweb-cover-300.jpg","editors":[{"id":"185895","title":"Dr.","name":"Michael","middleName":null,"surname":"Aide","slug":"michael-aide","fullName":"Michael Aide"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"269287","title":"Dr.","name":"Indi","middleName":null,"surname":"Braden","slug":"indi-braden","fullName":"Indi Braden","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F269287\u002F1781857959\u002Fprofile\u002Fimage1.png","biography":"Dr. Indi Braden received a bachelor’s in Biology from the College of the Ozarks, Missouri, a master’s in Crop, Soil, and Environmental Sciences from the University of Arkansas, and a Ph.D. in Agronomy - Crop Production and Physiology from Iowa State University. She began her academic career at Southeast Missouri State University in 2003, where she is currently a professor. In addition to her work at Southeast Missouri State University, Dr. Braden has worked with native wildflowers and prairie species, as well as rare and endangered species. She has worked to build learner-centered classrooms and lessons for students in plant science and physiology, forages, precision agriculture, geographical information systems, sustainable natural resource management, environmental science, and agribusiness. Her research interests include best management practices for sustainable natural resource management. Her research often includes water quality, agroecology, plant\u002Fanimal interactions in forage-based systems, cover crops, and a variety of other agronomic applications.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"10","totalChapterViews":"0","totalEditedBooks":"2","institution":{"name":"Southeast Missouri State University","institutionURL":null,"country":{"name":"United States of America"}},"countryString":"USA"},"coeditorTwo":{"id":"511648","title":"Dr.","name":"Shakirah","middleName":null,"surname":"Nakasagga","slug":"shakirah-nakasagga","fullName":"Shakirah Nakasagga","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F511648\u002F1781857992\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Shakirah Nakasagga is an Instructor at Southeast Missouri State University. Originally, she is from Uganda, East Africa. She earned her Ph.D. in Plant Breeding from Texas A&M University and an MSc. in Plant Breeding and Seed Systems from Makerere University, Uganda. In her current position, equipping students with experiential knowledge is key to learning and to preparing them to solve real-world problems. Her research focuses on developing perennial varieties of grain sorghum as a food crop and on perennial agricultural practices that reduce soil erosion and increase carbon sequestration.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"2","totalChapterViews":"0","totalEditedBooks":"1","institution":{"name":"Southeast Missouri State University","institutionURL":null,"country":{"name":"United States of America"}},"countryString":null},"coeditorThree":{"id":"186821","title":"Prof.","name":"António","middleName":null,"surname":"M. Jordão","slug":"antonio-m.-jordao","fullName":"António M. Jordão","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F186821\u002F1781858025\u002Fprofile\u002Fimage1.jpg","biography":"Prof. António M. Jordão is Associate Professor of Enology and Food Science at Polytechnic University of Viseu, School of Agriculture, Portugal. He graduated in Agro-Industrial Engineering from the University of Lisbon. He got a Master of Food Science and Technology and a Ph.D. in Agro-Industrial Engineering from the same University. Develops educational and research activities on topics related to the production of grapes, alcoholic beverages, bioactive compounds, and natural pigments. Member of several research projects and scientific editor of 12 books related to grape and wine composition. He published 60 scientific papers in peer-reviewed journals, 25 book chapters, and 150 communications at scientific congresses. He develops consultancy services for wine companies and Scientific and Innovation Agencies.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"5","totalChapterViews":"0","totalEditedBooks":"3","institution":{"name":"Polytechnic Institute of Viseu","institutionURL":null,"country":{"name":"Portugal"}},"countryString":"Portugal"},"coeditorFour":{"id":"618474","title":"Dr.","name":"Ana Cristina","middleName":null,"surname":"Correia","slug":"ana-cristina-correia","fullName":"Ana Cristina Correia","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F618474\u002F1781858052\u002Fprofile\u002Fimage1.png","biography":"Prof. Ana Cristina Correia is an Assistant Professor of food science and technology at the Polytechnic University of Viseu, School of Agriculture, Portugal. She graduated in Agro-Industrial Engineering from the Agronomy Higher Institute of the University of Lisbon, and obtained a master’s degree in Food Science and Technology from the same institution. She is associated with several research projects on food sensory analysis and grape and wine analysis. She has published 25 scientific papers in peer-reviewed journals, 6 book chapters, and 50 conference proceedings papers. She is involved in developing activities in the food analysis laboratory.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"totalAuthoredChapters":"1","totalChapterViews":"0","totalEditedBooks":"1","institution":{"name":"Polytechnic Institute of Viseu","institutionURL":null,"country":{"name":"Portugal"}},"countryString":null},"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter"}},{"type":"book","id":"23","title":"Modern Pacemakers","subtitle":"Present and Future","fullTitle":"Modern Pacemakers - Present and Future","isOpenForSubmission":false,"hash":null,"slug":"modern-pacemakers-present-and-future","isPublished":true,"bookSignature":"Mithilesh Kumar Das","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F23.jpg","numberOfDownloads":388109,"numberOfWosCitations":60,"numberOfTotalCitations":213,"numberOfCrossrefCitations":40,"numberOfDimensionsCitations":113,"kuFlag":false,"cdnCoverWithTextURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F23\u002F1718104300-1224315070\u002Fcover-text.jpg","cdnCoverWithTextURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F23\u002F1718104300-1224315070\u002Fcover-text-300.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F23\u002F1718265746-1012879677\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F23\u002F1718265746-1012879677\u002Fweb-cover-300.jpg","editors":[{"id":"61931","title":"Dr.","name":"Mithilesh","middleName":"K.","surname":"Das","slug":"mithilesh-das","fullName":"Mithilesh K. Das"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter"}}],"selectedChapters":[{"type":"chapter","id":"37067","title":"Fourier Transform Infrared Spectroscopy for Natural Fibres","slug":"fourier-transform-infrared-spectroscopy-for-natural-fibres","datePrePublished":null,"totalDimensionsCites":619,"isPublished":true,"isOnlineFirst":false,"book":{"slug":"fourier-transform-materials-analysis","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F2270.jpg"},"signatures":"Mizi Fan, Dasong Dai and Biao Huang","authors":[{"id":"104647","title":"Prof.","name":"Mizi","middleName":null,"surname":"Fan","slug":"mizi-fan","fullName":"Mizi Fan"}]}],"selectedSeries":[{"type":"series","id":"6","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries\u002Fcovers\u002F6.jpg","title":"Infectious Diseases","numberOfOpenTopics":4,"numberOfUpcomingTopics":0,"numberOfPublishedBooks":46,"numberOfPublishedChapters":396},{"type":"series","id":"7","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries\u002Fcovers\u002F7.jpg","title":"Biomedical Engineering","numberOfOpenTopics":3,"numberOfUpcomingTopics":0,"numberOfPublishedBooks":37,"numberOfPublishedChapters":290},{"type":"series","id":"11","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries\u002Fcovers\u002F11.jpg","title":"Biochemistry","numberOfOpenTopics":4,"numberOfUpcomingTopics":0,"numberOfPublishedBooks":71,"numberOfPublishedChapters":621},{"type":"series","id":"14","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries\u002Fcovers\u002F14.jpg","title":"Artificial Intelligence","numberOfOpenTopics":6,"numberOfUpcomingTopics":0,"numberOfPublishedBooks":48,"numberOfPublishedChapters":395}],"featuredNews":[{"id":"624","slug":"8000k-technology-cultural-heritage-and-scientific-diplomacy-20260430","title":"Reaching New Heights: IntechOpen Publishes its 8,000th Open Access Book","intro":"\u003Cp\u003EIntechOpen is proud to announce a significant milestone for 2026: the publication of our 8,000th open access book. This milestone comes shortly after the 20th anniversary of the publication of our first OA book.\u003C\u002Fp\u003E","introHomepage":null,"publishedDatetime":"May 6, 2026","mainMedia":{"id":"589","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F589"}},{"id":"614","slug":"20-years-of-open-access-books-a-milestone-for-intechopen-20251218","title":"20 Years of Open Access Books: A Milestone for IntechOpen","intro":"\u003Cp\u003EOver the past two decades, IntechOpen has grown into a global leader in open access book publishing, with an ever-expanding catalogue covering STM, as well as the social sciences and humanities. This milestone reflects not only the company&rsquo;s achievements but also the growing recognition of open access books as a vital model for academic publishing, contributing to the transformation of how knowledge is shared worldwide.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EOver the past two decades, IntechOpen has grown into a global leader in open access book publishing, with an ever-expanding catalogue covering STM, as well as the social sciences and humanities. This milestone reflects not only the company&rsquo;s achievements but also the growing recognition of open access books as a vital model for academic publishing, contributing to the transformation of how knowledge is shared worldwide.\u003C\u002Fp\u003E","publishedDatetime":"December 18, 2025","mainMedia":{"id":"580","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F580"}},{"id":"608","slug":"intechopen-among-first-publishers-to-go-live-with-oa-switchboard-books-solution-20251016","title":"IntechOpen Among First Publishers to Go Live with OA Switchboard Books Solution","intro":"\u003Cp\u003EWe are proud to announce that IntechOpen is among the first three publishers, alongside Cambridge University Press and University of Michigan Press, to go live with the OA Switchboard Books Solution.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EWe are proud to announce that IntechOpen is among the first three publishers, alongside Cambridge University Press and University of Michigan Press, to go live with the OA Switchboard Books Solution.\u003C\u002Fp\u003E","publishedDatetime":"October 16, 2025","mainMedia":{"id":"570","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F570"}},{"id":"590","slug":"intechopen-marked-7-500th-oa-book-release-with-climate-policies-co-edited-by-members-of-nobel-peace-prize-winning-ipcc-team-20250423","title":"IntechOpen Marked 7,500th OA Book Release with 'Climate Policies,' Co-edited by Members of Nobel Peace Prize-Winning IPCC Team","intro":"\u003Cp\u003ECo-edited by Gary Yohe and Joel Smith, senior members of the 2007 Nobel Peace Prize-winning Intergovernmental Panel on Climate Change (IPCC), this timely volume offers a comprehensive evaluation of contemporary climate policy strategies.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003ECo-edited by Gary Yohe and Joel Smith, senior members of the 2007 Nobel Peace Prize-winning Intergovernmental Panel on Climate Change (IPCC), this timely volume offers a comprehensive evaluation of contemporary climate policy strategies.\u003C\u002Fp\u003E","publishedDatetime":"April 23, 2025","mainMedia":{"id":"554","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F554"}},{"id":"585","slug":"researchgate-and-intechopen-announce-new-journal-home-partnership-20250325","title":"ResearchGate and IntechOpen Announce New Journal Home Partnership","intro":"\u003Cp\u003EAs part of our ongoing commitment to expanding the reach and visibility of open access research, we are excited to announce a new partnership with ResearchGate, the leading professional network for researchers. This collaboration will increase the reach and brand visibility of our journals through ResearchGate&rsquo;s Journal Home platform.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EAs part of our ongoing commitment to expanding the reach and visibility of open access research, we are excited to announce a new partnership with ResearchGate, the leading professional network for researchers. This collaboration will increase the reach and brand visibility of our journals through ResearchGate&rsquo;s Journal Home platform.\u003C\u002Fp\u003E","publishedDatetime":"March 25, 2025","mainMedia":{"id":"530","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F530"}},{"id":"530","slug":"intechopen-presents-interviews-for-young-scientists-with-science-s-leading-minds-20240708","title":"IntechOpen Presents Interviews for Young Scientists with Science's Leading Minds","intro":"\u003Cp\u003EWe are pleased to present a series of inspirational interviews for young researchers with some of today&#39;s leading scientists, ranging from a Nobel laureate to pioneers and innovators in various fields, including pharmacogenomics, pharmaceutical leadership, and academia.\u003C\u002Fp\u003E","introHomepage":null,"publishedDatetime":"July 8, 2024","mainMedia":{"id":"410","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F410"}},{"id":"527","slug":"intechopen-reaches-new-milestone-7-000-books-open-for-all-20240522","title":"IntechOpen Reaches New Milestone: 7,000 Books Open for All","intro":"\u003Cp\u003EIntechOpen has achieved a significant milestone in its mission to democratise scientific knowledge by announcing the publication of its 7,000th open access book, &#39;Towards the Eradication of\u003Cem\u003E Helicobacter pylori\u003C\u002Fem\u003E Infection - Rapid Diagnosis and Precision Treatment.&#39;&nbsp;Guided by the expertise of Dr Liang Wang, Dr Alfred Chin Yen Tay, and 2005 Nobel Prize Laureate Prof. Barry J. Marshall, this book offers insightful research and novel approaches, contributing to the continuous discourse on \u003Cem\u003EHelicobacter pylori\u003C\u002Fem\u003E-related research.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EIntechOpen has achieved a significant milestone in its mission to democratise scientific knowledge by announcing the publication of its 7,000th open access book, &#39;Towards the Eradication of\u003Cem\u003E Helicobacter pylori\u003C\u002Fem\u003E Infection - Rapid Diagnosis and Precision Treatment.&#39;&nbsp;Guided by the expertise of Dr Liang Wang, Dr Alfred Chin Yen Tay, and 2005 Nobel Prize Laureate Prof. Barry J. Marshall, this book offers insightful research and novel approaches, contributing to the continuous discourse on \u003Cem\u003EHelicobacter pylori\u003C\u002Fem\u003E-related research.\u003C\u002Fp\u003E","publishedDatetime":"May 22, 2024","mainMedia":{"id":"406","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F406"}},{"id":"464","slug":"intechopen-becomes-a-uksg-member-20230607","title":"IntechOpen Becomes a UKSG Member","intro":"\u003Cp\u003EIntechOpen is now an official member of the UKSG, the UK&#39;s largest scholarly communications community. Founded almost half a century ago, it connects the knowledge community and encourages the exchange of ideas in scholarly communication.\u003C\u002Fp\u003E","introHomepage":null,"publishedDatetime":"June 7, 2023","mainMedia":{"id":"405","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F405"}},{"id":"435","slug":"intechopen-book-wins-the-2022-international-academy-of-astronautics-life-science-book-award-20230328","title":"IntechOpen Book Wins the 2022 International Academy of Astronautics Life Science Book Award","intro":"\u003Cp\u003EWe are thrilled that the International Academy of Astronautics has chosen IntechOpen&#39;s book &quot;Preparation of Space Experiments&quot;, edited by Dr. Vladimir Pletser, to receive the IAA Life Science&nbsp;Book Award. The award is given annually to recognize excellence in publication by an Academy member or corresponding member in the field of life sciences.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EWe are thrilled that the International Academy of Astronautics has chosen IntechOpen&#39;s book &quot;Preparation of Space Experiments&quot;, edited by Dr. Vladimir Pletser, to receive the IAA Life Science&nbsp;Book Award. The award is given annually to recognize excellence in publication by an Academy member or corresponding member in the field of life sciences.\u003C\u002Fp\u003E","publishedDatetime":"March 28, 2023","mainMedia":{"id":"325","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F325"}}],"intechStatistics":{"openAccessBooks":"8,100","internationalAuthorsAndEditors":"206,000","downloads":"235M","deliversInCountries":"154","authorsAmongMostCitedScientists":"TOP 1%","authorsAndEditorsFromTopUniversities":"14%","dimensionsCitations":564530,"crossrefCitations":269736,"scientificWorks":89364,"researchInstitutions":11679,"publishedArticles":231},"globalStatistics":{"yearsInPublishingExperience":"15","institutionsPublishedWithUs":"500","visitorsPerMonth":"3.3 MILLION","downloadsPerYear":"150000","wosCitations":"+184,650","chapterPublished":"54,000"}},"newsLanding":{"offset":0,"limit":4,"total":null,"newsList":[]},"news":{"item":{"slug":"step-in-the-right-direction-intechopen-launches-a-portfolio-of-open-science-journals-20220414","title":"Step in the Right Direction: IntechOpen Launches a Portfolio of Open Science Journals","subtitle":null,"metaTitle":"Step in the Right Direction: IntechOpen Launches a Portfolio of Open Science Journals","metaDescription":"After years of being acknowledged as the world&#39;s leading publisher of Open Access books, today, we are proud to announce we&rsquo;ve successfully launched a portfolio of Open Science journals covering rapidly expanding areas of interdisciplinary research.","metaKeywords":null,"publishedDatetime":"April 14, 2022","endDate":null,"newsType":"1","contentRaw":"[{\"type\":\"htmlEditorComponent\",\"content\":\"\u003Cp\u003EAfter years of being acknowledged as the world&#39;s leading publisher of Open Access books, today, we are proud to announce we&rsquo;ve successfully launched a portfolio of \u003Ca href=\\\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\\\" target=\\\"_blank\\\"\u003EOpen Science journals\u003C\u002Fa\u003E covering rapidly expanding areas of interdisciplinary research.\u003C\u002Fp\u003E\\n\\n\u003Cp\u003E\u003Cvideo controls style=\\\"width: 100%;-webkit-box-shadow: 0px 0px 2px 0px rgba(0, 0, 0, 0.05);box-shadow: 2px -2px 6px 2px rgb(0 0 0 \u002F 7%);\\\"\u003E\u003Csource src=\\\"https:\u002F\u002Fcdn.intechopen.com\u002Fpublic\u002Fvideos\u002FJournals_Web.mp4\\\" type=\\\"video\u002Fmp4\\\"\u002F\u003E\u003C\u002Fvideo\u003E\u003C\u002Fp\u003E\\n\\n\u003Cp\u003EIntechOpen was founded by scientists, for scientists, in order to make book publishing accessible around the globe. Over the last two decades, this has driven Open Access (OA) book publishing whilst levelling the playing field for global academics. Through our innovative publishing model and the support of the research community, we have now published over \u003Cstrong\u003E5,700 Open Access books\u003C\u002Fstrong\u003E and are visited online by over three million academics every month. These researchers are increasingly working in broad technology-based subjects, driving multidisciplinary academic endeavours into human health, environment, and technology.\u003C\u002Fp\u003E\\n\\n\u003Cp\u003EBy listening to our community, and in order to serve these rapidly growing areas which lie at the core of IntechOpen&#39;s expertise, we are launching a portfolio of Open Science journals:\u003C\u002Fp\u003E\\n\\n\u003Cul\u003E\\n\\t\u003Cli\u003E\u003Ca href=\\\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F1\\\" target=\\\"_blank\\\"\u003EAI, Computer Science and Robotics Technology\u003C\u002Fa\u003E\u003C\u002Fli\u003E\\n\\t\u003Cli\u003E\u003Ca href=\\\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F4\\\" target=\\\"_blank\\\"\u003EDigital Medicine and Healthcare Technology\u003C\u002Fa\u003E&nbsp;&nbsp;\u003C\u002Fli\u003E\\n\\t\u003Cli\u003E\u003Ca href=\\\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F7\\\" target=\\\"_blank\\\"\u003EGreen Energy and Environmental Technology\u003C\u002Fa\u003E\u003C\u002Fli\u003E\\n\u003C\u002Ful\u003E\\n\\n\u003Cp\u003EAll three journals will publish under an Open Access model and embrace Open Science policies to help support the changing needs of academics in these fast-moving research areas. There will be direct links to preprint servers and data repositories, allowing full reproducibility and rapid dissemination of published papers to help accelerate the pace of research. Each journal has renowned Editors in Chief who will work alongside a global Editorial Board, delivering robust single-blind peer review. Supported by our internal editorial teams, this will ensure our authors will receive a quick, user-friendly, and personalised publishing experience.\u003C\u002Fp\u003E\\n\\n\u003Cp\u003E&nbsp;&quot;\u003Cem\u003EBy launching our journals portfolio we are introducing new, dedicated homes for interdisciplinary technology-focused researchers to publish their work, whilst embracing Open Science and creating a unique global home for academics to disseminate their work. We are taking a leap toward Open Science continuing and expanding our fundamental commitment to openly sharing scientific research across the world, making it available for the benefit of all.\u003C\u002Fem\u003E&quot; \u003Cstrong\u003EDr. Sara Uhac, IntechOpen CEO\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\\n\\n\u003Cp\u003E&quot;\u003Cem\u003EOur aim is to promote and create better science for a better world by increasing access to information and the latest scientific developments to all scientists, innovators, entrepreneurs and students and give them the opportunity to learn, observe and contribute to knowledge creation. Open Science promotes a swifter path from research to innovation to produce new products and services.\u003C\u002Fem\u003E&quot; \u003Cstrong\u003EAlex Lazinica, IntechOpen founder&nbsp;\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\\n\\n\u003Cp\u003EIn conclusion, \u003Cstrong\u003ENatalia Reinic Babic, Head of Journal Publishing and Open Science\u003C\u002Fstrong\u003E at IntechOpen adds:\u003C\u002Fp\u003E\\n\\n\u003Cp\u003E&ldquo;\u003Cem\u003EOn behalf of the journal team I&rsquo;d like to thank all our Editors in Chief, Editorial Boards, internal supporting teams, and our scientific community for their continuous support in making this portfolio a reality - we couldn&rsquo;t have done it without you! With your support in place, we are confident these journals will become as impactful and successful as our book publishing program and bring us closer to a more open (science) future.\u003C\u002Fem\u003E&rdquo;\u003C\u002Fp\u003E\\n\\n\u003Cp\u003EWe invite you to visit the \u003Ca href=\\\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\\\" target=\\\"_blank\\\"\u003Ejournals homepage\u003C\u002Fa\u003E and&nbsp; learn more about the journal&rsquo;s Editorial Boards, scope and vision as all three journals are now open for submissions.&nbsp;\u003C\u002Fp\u003E\\n\\n\u003Cp\u003EFeel free to share this news on social media and help us mark this memorable moment!\u003C\u002Fp\u003E\\n\\n\u003Cp\u003E&nbsp;\u003C\u002Fp\u003E\\n\"}]","published":true,"mainMedia":{"caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F237"}},"components":[{"type":"htmlEditorComponent","content":"\u003Cp\u003EAfter years of being acknowledged as the world&#39;s leading publisher of Open Access books, today, we are proud to announce we&rsquo;ve successfully launched a portfolio of \u003Ca href=\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\" target=\"_blank\"\u003EOpen Science journals\u003C\u002Fa\u003E covering rapidly expanding areas of interdisciplinary research.\u003C\u002Fp\u003E\n\n\u003Cp\u003E\u003Cvideo controls style=\"width: 100%;-webkit-box-shadow: 0px 0px 2px 0px rgba(0, 0, 0, 0.05);box-shadow: 2px -2px 6px 2px rgb(0 0 0 \u002F 7%);\"\u003E\u003Csource src=\"https:\u002F\u002Fcdn.intechopen.com\u002Fpublic\u002Fvideos\u002FJournals_Web.mp4\" type=\"video\u002Fmp4\"\u002F\u003E\u003C\u002Fvideo\u003E\u003C\u002Fp\u003E\n\n\u003Cp\u003EIntechOpen was founded by scientists, for scientists, in order to make book publishing accessible around the globe. Over the last two decades, this has driven Open Access (OA) book publishing whilst levelling the playing field for global academics. Through our innovative publishing model and the support of the research community, we have now published over \u003Cstrong\u003E5,700 Open Access books\u003C\u002Fstrong\u003E and are visited online by over three million academics every month. These researchers are increasingly working in broad technology-based subjects, driving multidisciplinary academic endeavours into human health, environment, and technology.\u003C\u002Fp\u003E\n\n\u003Cp\u003EBy listening to our community, and in order to serve these rapidly growing areas which lie at the core of IntechOpen&#39;s expertise, we are launching a portfolio of Open Science journals:\u003C\u002Fp\u003E\n\n\u003Cul\u003E\n\t\u003Cli\u003E\u003Ca href=\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F1\" target=\"_blank\"\u003EAI, Computer Science and Robotics Technology\u003C\u002Fa\u003E\u003C\u002Fli\u003E\n\t\u003Cli\u003E\u003Ca href=\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F4\" target=\"_blank\"\u003EDigital Medicine and Healthcare Technology\u003C\u002Fa\u003E&nbsp;&nbsp;\u003C\u002Fli\u003E\n\t\u003Cli\u003E\u003Ca href=\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\u002F7\" target=\"_blank\"\u003EGreen Energy and Environmental Technology\u003C\u002Fa\u003E\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\n\u003Cp\u003EAll three journals will publish under an Open Access model and embrace Open Science policies to help support the changing needs of academics in these fast-moving research areas. There will be direct links to preprint servers and data repositories, allowing full reproducibility and rapid dissemination of published papers to help accelerate the pace of research. Each journal has renowned Editors in Chief who will work alongside a global Editorial Board, delivering robust single-blind peer review. Supported by our internal editorial teams, this will ensure our authors will receive a quick, user-friendly, and personalised publishing experience.\u003C\u002Fp\u003E\n\n\u003Cp\u003E&nbsp;&quot;\u003Cem\u003EBy launching our journals portfolio we are introducing new, dedicated homes for interdisciplinary technology-focused researchers to publish their work, whilst embracing Open Science and creating a unique global home for academics to disseminate their work. We are taking a leap toward Open Science continuing and expanding our fundamental commitment to openly sharing scientific research across the world, making it available for the benefit of all.\u003C\u002Fem\u003E&quot; \u003Cstrong\u003EDr. Sara Uhac, IntechOpen CEO\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\n\u003Cp\u003E&quot;\u003Cem\u003EOur aim is to promote and create better science for a better world by increasing access to information and the latest scientific developments to all scientists, innovators, entrepreneurs and students and give them the opportunity to learn, observe and contribute to knowledge creation. Open Science promotes a swifter path from research to innovation to produce new products and services.\u003C\u002Fem\u003E&quot; \u003Cstrong\u003EAlex Lazinica, IntechOpen founder&nbsp;\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\n\u003Cp\u003EIn conclusion, \u003Cstrong\u003ENatalia Reinic Babic, Head of Journal Publishing and Open Science\u003C\u002Fstrong\u003E at IntechOpen adds:\u003C\u002Fp\u003E\n\n\u003Cp\u003E&ldquo;\u003Cem\u003EOn behalf of the journal team I&rsquo;d like to thank all our Editors in Chief, Editorial Boards, internal supporting teams, and our scientific community for their continuous support in making this portfolio a reality - we couldn&rsquo;t have done it without you! With your support in place, we are confident these journals will become as impactful and successful as our book publishing program and bring us closer to a more open (science) future.\u003C\u002Fem\u003E&rdquo;\u003C\u002Fp\u003E\n\n\u003Cp\u003EWe invite you to visit the \u003Ca href=\"https:\u002F\u002Fwww.intechopen.com\u002Fjournals\" target=\"_blank\"\u003Ejournals homepage\u003C\u002Fa\u003E and&nbsp; learn more about the journal&rsquo;s Editorial Boards, scope and vision as all three journals are now open for submissions.&nbsp;\u003C\u002Fp\u003E\n\n\u003Cp\u003EFeel free to share this news on social media and help us mark this memorable moment!\u003C\u002Fp\u003E\n\n\u003Cp\u003E&nbsp;\u003C\u002Fp\u003E\n"}],"latestNews":[{"slug":"geet-launches-sdg-rising-star-2026-for-early-career-researchers-20260720","title":"GEET Launches SDG Rising Star 2026 for Early-Career Researchers"},{"slug":"acrt-rising-star-2025-initiative-names-this-year-s-rising-star-20260716","title":"ACRT Rising Star 2025 Initiative Selects Its Rising Star"},{"slug":"intechopen-to-sponsor-oaspa-2026-conference-20260617","title":"IntechOpen to Sponsor OASPA 2026 Conference"},{"slug":"new-intechopen-titles-become-available-through-ku-select-2026-20260519","title":"New IntechOpen Titles Become Available Through KU Select 2026"},{"slug":"geet-journal-sees-increase-in-sdg-focused-research-20260508","title":"GEET Journal Sees Increase in SDG-Focused Research "},{"slug":"8000k-technology-cultural-heritage-and-scientific-diplomacy-20260430","title":"Reaching New Heights: IntechOpen Publishes its 8,000th Open Access Book"},{"slug":"intechopen-book-series-release-annual-volumes-for-2025-20260415","title":"IntechOpen Book Series Release Annual Volumes for 2025"},{"slug":"new-book-collection-with-knowledge-unlatched-bringing-expert-ai-research-to-open-access-20260327","title":"New Book Collection With Knowledge Unlatched: Bringing Expert AI Research to Open Access"}]},"book":{"item":{"type":"book","id":"7846","leadTitle":null,"fullTitle":"Universal Health Coverage","title":"Universal Health Coverage","subtitle":null,"reviewType":"peer-reviewed","abstract":"The chapters in this book contribute to the wide discussion on universal health coverage. The variety of topics discussed here confirms the importance of UHC for academics and health professionals and also the controversies and challenges of its implementation.I invite you to read the book and be involved in the discussions around the goals of universal health coverage.","isbn":"978-1-78984-975-2","printIsbn":"978-1-78984-974-5","pdfIsbn":"978-1-78984-646-1","doi":"10.5772\u002Fintechopen.77664","price":119,"priceEur":135,"priceUsd":150,"priceCbs":null,"slug":"universal-health-coverage","numberOfPages":128,"isOpenForSubmission":false,"isInWos":null,"isInBkci":false,"hash":"03f74e6a4e925b7368b87e813bc29e1f","bookSignature":"Aida Isabel Tavares","publishedDate":"November 27th 2019","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F7846.jpg","cdnWebCoverURL":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F7846\u002F1718277266-753398428\u002Fweb-cover.jpg","cdnWebCoverURL300":"https:\u002F\u002Fcdnintech.com\u002Fbooks\u002F7846\u002F1718277266-753398428\u002Fweb-cover-300.jpg","numberOfDownloads":13738,"numberOfViews":0,"numberOfWosCitations":6,"numberOfCrossrefCitations":38,"numberOfCrossrefCitationsByBook":0,"numberOfDimensionsCitations":51,"numberOfDimensionsCitationsByBook":6,"hasAltmetrics":1,"totalAltmetricsMentions":16,"numberOfTotalCitations":95,"isAvailableForWebshopOrdering":true,"dateEndFirstStepPublish":"December 12th 2018","dateEndSecondStepPublish":"February 8th 2019","dateEndThirdStepPublish":"April 9th 2019","dateEndFourthStepPublish":"June 28th 2019","dateEndFifthStepPublish":"August 27th 2019","currentStepOfPublishingProcess":5,"indexedIn":"1,2,3,4,5,6","editedByType":"Edited by","kuFlag":false,"sdgRelated":null,"featuredMarkup":null,"isPublished":true,"isPublisherCbs":false,"cbsWebsiteURL":null,"noAds":0,"editors":[{"id":"196819","title":"Prof.","name":"Aida Isabel","middleName":null,"surname":"Tavares","slug":"aida-isabel-tavares","fullName":"Aida Isabel Tavares","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F196819\u002F1773305961\u002Fprofile\u002Fimage1.jpg","biography":"Aida Isabel Tavares holds a Ph.D. in Economic Analysis and a Ph.D. in Management - Science Applied to Decision Making. Her research areas include health economics and policy, health systems, socioeconomic determinants of health, and regulation in health markets. She has taught courses on microeconomics, public economics, and health economics. Currently, she is an Associate Professor at the Lisbon School of Economics and Management, University of Lisbon, and a researcher at the Centre of Studies and Research in Health, University of Coimbra, Portugal.","institutionString":null,"position":null,"outsideEditionCount":null,"totalCites":0,"orcid":null,"totalAuthoredChapters":"8","totalChapterViews":"0","totalEditedBooks":"5","institution":{"name":"University of Lisbon","institutionURL":null,"country":{"name":"Portugal"}},"countryString":"Portugal","tags":null}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"topics":[{"id":"1132","title":"Health Care","slug":"medicine-public-health-health-care"}],"productType":{"id":"1","title":"Edited Volume","chapterContentType":"chapter","authoredCaption":"Edited by"},"series":null,"subseries":null,"tags":null,"_preview":0,"chapters":[{"id":"69411","title":"Introductory Chapter: Universal Health Coverage","doi":"10.5772\u002Fintechopen.89343","slug":"introductory-chapter-universal-health-coverage","totalDownloads":904,"totalCrossrefCites":0,"totalDimensionsCites":0,"hasAltmetrics":0,"orderNumber":1,"abstract":null,"signatures":"Aida Isabel Tavares","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F69411","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F69411","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"196819","title":"Prof.","name":"Aida Isabel","surname":"Tavares","slug":"aida-isabel-tavares","fullName":"Aida Isabel Tavares","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"68032","title":"Provider Payment Mechanisms: Effective Policy Tools for Achieving Universal and Sustainable Healthcare Coverage","doi":"10.5772\u002Fintechopen.86840","slug":"provider-payment-mechanisms-effective-policy-tools-for-achieving-universal-and-sustainable-healthcar","totalDownloads":2362,"totalCrossrefCites":12,"totalDimensionsCites":14,"hasAltmetrics":1,"orderNumber":2,"abstract":"Globally, governments are seeking to develop equitable and sustainable healthcare systems for delivering universal healthcare coverage under budget constraints. This chapter provides an analysis of fee-for-service, a commonly used payment mechanism for reimbursement of healthcare providers, and proposes appropriate reform in order to promote cost containment in the context of low- and middle-income countries (LMICs). The analysis used secondary data derived from the literature. The analysis revealed that capitation, case-based, and global budget provider payment mechanisms have the potential to control healthcare costs by creating incentives for providers to reduce the volume of services. Capitation payment has the potential to promote provider efficiency, while global budget may reward inefficient hospitals if risk adjustors (such as gender and age) are not considered in the resource allocation formula. Both capitation payment and global budget have lower administrative costs compared to fee-for-service. Development of supporting measures is crucial including legal, financial, referral, quality assurance, and management information systems.","signatures":"Abualbishr Alshreef","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F68032","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F68032","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"294851","title":"Ph.D. Student","name":"Abualbishr","surname":"Alshreef","slug":"abualbishr-alshreef","fullName":"Abualbishr Alshreef","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"69420","title":"Universal Health Coverage, Long-Term Care, and Funding in an Aging Era","doi":"10.5772\u002Fintechopen.89618","slug":"universal-health-coverage-long-term-care-and-funding-in-an-aging-era","totalDownloads":1326,"totalCrossrefCites":1,"totalDimensionsCites":1,"hasAltmetrics":0,"orderNumber":3,"abstract":"Universal health coverage has been gaining a wider attention since the beginning of the 2000s, and it has become an ideological reference for health systems across the world. Funding universal health coverage has been a major challenge faced by governments. Not only funding has to be efficient to guarantee people’s access to health services when they are needed, but also it has to ensure equity across people in the country. Aging implies a new constraint to funding as more people contribute less to the collection of financial revenues and more people are in need of healthcare, due to morbidity and end-of-life needs. This chapter aims to present the concept of universal health coverage and LTC and also to discuss how it may be financed under the current scenario of demographic aging and increasing demand for long-term care.","signatures":"Aida Isabel Tavares and Pedro Lopes Ferreira","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F69420","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F69420","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"196819","title":"Prof.","name":"Aida Isabel","surname":"Tavares","slug":"aida-isabel-tavares","fullName":"Aida Isabel Tavares","tags":null},{"id":"171100","title":"Prof.","name":"Pedro","surname":"Ferreira","slug":"pedro-ferreira","fullName":"Pedro Ferreira","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"67470","title":"Healthcare Coverage and Affordability in Nigeria: An Alternative Model to Equitable Healthcare Delivery","doi":"10.5772\u002Fintechopen.85978","slug":"healthcare-coverage-and-affordability-in-nigeria-an-alternative-model-to-equitable-healthcare-delive","totalDownloads":3162,"totalCrossrefCites":19,"totalDimensionsCites":24,"hasAltmetrics":1,"orderNumber":4,"abstract":"Healthcare delivery in Nigeria has faced major challenges toward achieving universal health coverage. While significant progress was made in the first two decades after the country’s independence in 1960, the economic downturn resulting from the plummeting of oil price of which Nigeria was dependent led to a series of twists and turns in the health sector. Health policies were subsequently influenced by external forces, and the adoption of the structural adjustment program signaled a shift from a predominantly welfare scheme to the introduction of user fee and the resultant proliferation of private healthcare provision. This paper discusses the crises that followed the turbulent health policies ever since by identifying some key factors that were glossed over by successive government regimes in formulating health policies in Nigeria. The paper concludes by suggesting a more inclusive model that will ensure equitability in the health sector and accessibility to healthcare services in the country.","signatures":"Alex E. Asakitikpi","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F67470","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F67470","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"290324","title":"Associate Prof.","name":"Alex","surname":"Asakitikpi","slug":"alex-asakitikpi","fullName":"Alex Asakitikpi","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"66371","title":"Caring for Older People - Improving Healthcare Quality to Ensure Well-Being and Dignity","doi":"10.5772\u002Fintechopen.85598","slug":"caring-for-older-people-improving-healthcare-quality-to-ensure-well-being-and-dignity","totalDownloads":1907,"totalCrossrefCites":2,"totalDimensionsCites":3,"hasAltmetrics":0,"orderNumber":5,"abstract":"The aim of caring is to promote health. The global trend is that people are living longer, but in many cases, there is no support system for the care of older people, leading to major challenges in ensuring their health and well-being. The proportion of older people is expected to increase globally, and skilled healthcare professionals will be required to care for them. There is a risk that older people as suffering and vulnerable human beings will be forgotten due to the increasingly effective and technical care worldwide. A caring culture and relationship should be prioritised and developed to promote participation, well-being and dignity for older people in order to fulfil their care needs and ensure quality healthcare. It is important that research focusing on universal health coverage identifies the benefits of increased investment in service quality. To contribute to the improvement of this output, we propose the application of Eriksson’s caritative theory. The aim of this theoretical chapter is to provide examples of how the dignity and well-being of older people can be promoted, at no additional cost to the person, by means of Eriksson’s caritative theory, which can strengthen healthcare for universal health coverage.","signatures":"Sandra Pennbrant and Margareta Karlsson","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F66371","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F66371","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"291149","title":"Associate Prof.","name":"Sandra","surname":"Pennbrant","slug":"sandra-pennbrant","fullName":"Sandra Pennbrant","tags":null},{"id":"291150","title":"Dr.","name":"Margareta","surname":"Karlsson","slug":"margareta-karlsson","fullName":"Margareta Karlsson","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"67462","title":"An Intersectional Innovative Analysis of How Providers’ Discourses Interact with Universal Healthcare Access","doi":"10.5772\u002Fintechopen.86208","slug":"an-intersectional-innovative-analysis-of-how-providers-discourses-interact-with-universal-healthcare","totalDownloads":1422,"totalCrossrefCites":1,"totalDimensionsCites":1,"hasAltmetrics":0,"orderNumber":6,"abstract":"Intersectionality is an analytical tool for understanding the ways gender intersects with and is constituted by other social factors such as social class, age, and ethnicity, among others. The chapter discusses the theoretical and analytical intersectionality perspective, focusing on its application to an analysis of empirical data obtained from qualitative research. Semi-structured interviews took place with healthcare providers in Cordoba, Argentina. Thematic analysis was conducted. The findings show the existence of multiple domination systems incorporated in providers’ discourses. All of them interact and contribute to gender inequalities in health, specifically on women’s access to universal healthcare for violence against women and\u002For health of migrant women increasing their vulnerability. Training and sensitization among providers regarding gender and health from an intersectional approach are highly recommended as the first step toward a better healthcare system response.","signatures":"Lorena Saletti-Cuesta and Lila Aizenberg","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F67462","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F67462","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"290092","title":"Dr.","name":"Lorena","surname":"Saletti-Cuesta","slug":"lorena-saletti-cuesta","fullName":"Lorena Saletti-Cuesta","tags":null},{"id":"290306","title":"Dr.","name":"Lila","surname":"Aizenberg","slug":"lila-aizenberg","fullName":"Lila Aizenberg","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"67635","title":"The Brazilian Unified Health System: Thirty Years of Advances and Resistance","doi":"10.5772\u002Fintechopen.86834","slug":"the-brazilian-unified-health-system-thirty-years-of-advances-and-resistance","totalDownloads":1439,"totalCrossrefCites":0,"totalDimensionsCites":3,"hasAltmetrics":1,"orderNumber":7,"abstract":"In 1988, in the context of the re-democratization of Brazil after an authoritarian period, a new Federal Constitution promoted an institutional rupture in the hitherto valid frameworks of health policy, whose origin and expansion until then had been prioritized by the means of insurance restricted to workers inserted in the formal labor market. The constitution has defined principles and guidelines for a reform informed by a publicist perspective and by a conception of health as the right of everyone and the duty of the state, with the corollary of universalization and equality. For this, the unique health system was created. The chapter aims to describe the construction and evolution of the universal health system of Brazil and its results and perspectives. The construction of the universal system from a segmentation legacy, considering the argument that the previous policies defined constraints for the subsequent institutional development, is portrayed. After that, the evolution of the health system and its results and political, financial, and institutional difficulties, also considering the institutional characteristics derived from Brazilian federative institutions, has been discussed. Finally, the country’s current political scenario is presented, which points to a new cycle of social policies, including health policy, in the sense of restricting spending and rights.","signatures":"Telma Maria Gonçalves Menicucci","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F67635","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F67635","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"295111","title":"Dr.","name":"Telma Maria","surname":"Menicucci","slug":"telma-maria-menicucci","fullName":"Telma Maria Menicucci","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0},{"id":"68952","title":"Economic Crisis, Decentralisation and Health Inequalities: The Case of Italy","doi":"10.5772\u002Fintechopen.89006","slug":"economic-crisis-decentralisation-and-health-inequalities-the-case-of-italy","totalDownloads":1219,"totalCrossrefCites":3,"totalDimensionsCites":5,"hasAltmetrics":1,"orderNumber":8,"abstract":"The chapter describes the recent evolution of the Italian National Health Service (NHS), highlighting the potential and effective consequences of the economic and financial crisis on social and territorial inequalities, especially in terms of service access and quality. First, it analyses the cost-containment and austerity policies in the NHS, which brought to a relevant underfunding of the public healthcare system, comparing public expenditure trends in Italy with those of other Western European countries. Then, it stresses the increasing role played by private expenditure, emphasizing the risks in terms of health inequalities connected to the high level of out-of-pocket payments and to the spread of the occupational funds. Finally, a reconstruction and analysis of the current changes in the NHS governance is carried out, explaining in details how the reassertion of the role of the Central State in health policy entails different consequences for different areas of Italy, widening the territorial inequalities and increasing the North-South divide. So far, these changes have taken place without any structural reform, in an imperceptible but progressive way, which does not help to develop an appropriate and necessary debate on the future of the healthcare system.","signatures":"Stefano Neri","downloadPdfUrl":"\u002Fchapter\u002Fpdf-download\u002F68952","previewPdfUrl":"\u002Fchapter\u002Fpdf-preview\u002F68952","isPublished":true,"isOnlineFirst":false,"isDeactivated":0,"status":"active","authors":[{"id":"294896","title":"Dr.","name":"Stefano","surname":"Neri","slug":"stefano-neri","fullName":"Stefano Neri","tags":null}],"corrections":null,"isDeactivated2":0,"deactCorrection":null,"_preview":0}]},"relatedBooks":[{"type":"book","id":"11223","title":"Health Insurance","subtitle":null,"isOpenForSubmission":false,"isPublished":true,"hash":"ac807af80e975c275849c56791cd15b3","slug":"health-insurance","bookSignature":"Aida Isabel Tavares","coverURL":"https:\u002F\u002Fcdn.intechopen.com\u002Fbooks\u002Fimages_new\u002F11223.jpg","editedByType":"Edited by","editors":[{"id":"196819","title":"Prof.","name":"Aida Isabel","middleName":null,"surname":"Tavares","slug":"aida-isabel-tavares","fullName":"Aida Isabel Tavares"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"1003465","title":"Economics of Healthcare","subtitle":"Studies and Cases","isOpenForSubmission":false,"isPublished":true,"hash":"a91f329955267351f40163f271bf03a2","slug":null,"bookSignature":"Aida Isabel Tavares","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa043Y000010Jz7oQAC\u002F0015369_TrikoderCover%20%282023-04-28%2008%3A13%3A03%29.jpg","editedByType":"Edited by","editors":[{"id":"196819","title":"Prof.","name":"Aida Isabel","middleName":null,"surname":"Tavares","slug":"aida-isabel-tavares","fullName":"Aida Isabel Tavares"}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"c