dnintech.com\u002Fmedia\u002Fauthor\u002F490052\u002F1763715829\u002Fprofile\u002Fimage1.jpg","orcid":"0000-0001-6692-460X","institutionString":null,"institution":{"name":"Ajayi Crowther University","institutionURL":null,"country":{"name":"Nigeria"}}}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":null,"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1"}},{"type":"book","id":"1004555","title":"The Future of Work","subtitle":"The Development of Sustainable Workplaces","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc000009jNZuIAM\u002F0016459_TrikoderCover%20%282024-08-21%2013%3A18%3A28%29.jpg","slug":null,"isPublished":true,"publishedDate":"December 3rd 2025","editedByType":null,"bookSignature":"Larisa Ivascu and Florin Dragan","hash":"fd50254149ad2f8beabb783d9550f3c3","volumeInSeries":8,"fullTitle":"The Future of Work - The Development of Sustainable Workplaces","kuFlag":false,"editors":[{"id":"288698","title":"Prof.","name":"Larisa","middleName":null,"surname":"Ivașcu","slug":"larisa-ivascu","fullName":"Larisa Ivașcu","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F288698\u002F1773318133\u002Fprofile\u002Fimage1.png","orcid":"0000-0003-1506-5467","institutionString":"Politehnica University of Timisoara, Romania","institution":null}],"equalEditorOne":null,"equalEditorTwo":null,"equalEditorThree":null,"coeditorOne":{"id":"582240","title":"Associate Prof.","name":"Florin","middleName":null,"surname":"Dragan","slug":"florin-dragan","fullName":"Florin Dragan"},"coeditorTwo":null,"coeditorThree":null,"coeditorFour":null,"coeditorFive":null,"productType":{"id":"1"}}]},"subseriesFiltersForPublishedBooks":[],"publicationYearFilters":[{"group":"publicationYear","caption":"2026","value":2026,"count":11},{"group":"publicationYear","caption":"2025","value":2025,"count":8}],"authors":{"paginationCount":547,"paginationItems":[{"id":"72288","title":"Prof.","name":"Arli Aditya","middleName":null,"surname":"Parikesit","slug":"arli-aditya-parikesit","fullName":"Arli Aditya Parikesit","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F72288\u002F1779897416\u002Fprofile\u002Fimage1.jpg","biography":"Prof. Dr. rer. nat. Arli Aditya Parikesit is a distinguished Indonesian bioinformatician and Professor of Bioinformatics at the i3L University (formerly Indonesia International Institute for Life Sciences) in Jakarta, Indonesia. He has dedicated his career to advancing computational biology, with research interests spanning structural bioinformatics, immunoinformatics, rational drug and vaccine design, and the integration of artificial intelligence (AI) in molecular simulations.\r\nProf. Parikesit completed his undergraduate and Master’s studies in Chemistry and Biotechnology at the University of Indonesia. Supported by a DAAD (German Academic Exchange Service) fellowship, he earned his Ph.D. (Dr. rer. nat.) in Bioinformatics from the University of Leipzig, Germany, where his doctoral research focused on advanced protein domain annotation across the three domains of life.\r\nThroughout his career, Prof. Parikesit has held several key academic and leadership roles at i3L University, serving as the Head of the Bioinformatics Department (2016-2021) and the Vice-Rector for Research and Innovation (2021-2024). Up to now, Prof Parikesit still serves as an academic senate member. A highly active voice in the global scientific community, he has published over 150 peer-reviewed papers in international journals and conference proceedings. His current research leverages machine learning, transcriptomics, and computational pipelines to design modern diagnostics and RNA-based therapeutics. He is a member of the Indonesian Society for Bioinformatics and Biodiversity (MABBI) and an honorary member of the Indonesian Young Academy of Science (ALMI), dedicated to bridging academic innovation, industrial application, and public health policy.","orcid":"0000-0001-8716-3926","institutionString":null,"institution":{"name":"Indonesia International Institute for Life Sciences","country":{"name":"Indonesia"}}},{"id":"275570","title":"Dr.","name":"Abdullah A.","middleName":null,"surname":"Elgazar","slug":"abdullah-a.-elgazar","fullName":"Abdullah A. Elgazar","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F275570\u002F1750254504\u002Fprofile\u002Fimage1.png","biography":null,"orcid":null,"institutionString":null,"institution":{"name":"Kafrelsheikh University","country":{"name":"Egypt"}}},{"id":"436800","title":"Dr.","name":"Rohit","middleName":null,"surname":"Bhatia","slug":"rohit-bhatia","fullName":"Rohit Bhatia","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F436800\u002F1768376509\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Rohit Bhatia has 13 years of experience in academics, administration, and research. He specializes in Medicinal Chemistry, Computer-Aided Drug Design, and Bioanalysis. His areas of interest include anticancer drug discovery and paper-based microfluidics.  He has published more than 150 research and review articles in various international and national journals. He has published more than 12 book chapters. He has delivered more than 20 guest lectures as a speaker on various National and International platforms.  He has qualified for the GPAT exam four times. He has guided 32 postgraduate students and 6 Ph.D students. He is a potential reviewer for various internationally reputed journals. He served as the brand ambassador for Bentham Science in 2019 and 2024. He has also presented his research at various national and international conferences. The Government of India has granted him 12 patents. Recently, he received a grant of 20 lakh from MSME, India, to develop a point-of-care device for detecting glucose in human saliva. He has been awarded the Young Scientist Award twice on international platforms. He has also authored six books.","orcid":"0000-0003-4194-8749","institutionString":null,"institution":{"name":"Chitkara University","country":{"name":"India"}}},{"id":"672803","title":"Dr.","name":"Mehmood","middleName":null,"surname":"Sajid","slug":"mehmood-sajid","fullName":"Mehmood Sajid","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F672803\u002F1777555595\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":"","institutionString":"Independent Researcher","institution":null},{"id":"596172","title":"Prof.","name":"Kanchan","middleName":null,"surname":"Bhardwaj","slug":"kanchan-bhardwaj","fullName":"Kanchan Bhardwaj","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F596172\u002F1765942846\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":null,"institutionString":"Manav Rachna International Institute of Research and Studies, Faridabad","institution":null},{"id":"213344","title":"Prof.","name":"Ibrokhim Y.","middleName":null,"surname":"Abdurakhmonov","slug":"ibrokhim-y.-abdurakhmonov","fullName":"Ibrokhim Y. Abdurakhmonov","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F213344\u002F1783349840\u002Fprofile\u002Fimage1.jpg","biography":"Ibrokhim Y. Abdurakhmonov received his BS in Biotechnology from the National University, Uzbekistan, in 1997, an MS in Plant Breeding from Texas A&M University in 2001, and a Ph.D. in Molecular Genetics and DSc from the Academy of Sciences of Uzbekistan in 2002 and 2009, respectively. He became a full professor at the same university in 2011. He founded the Center of Genomics and Bioinformatics of Uzbekistan in 2012. Dr. Abdurakhmonov was elected as a fellow of The World Academy of Sciences (TWAS) in 2014 and a member of the Academy of Sciences of Uzbekistan in 2017. He served as Uzbekistan's Minister of Innovative Development from 2017 to 2022. He served as Uzbekistan's Minister of Higher Education, Science, and Innovations from 2022 to 2023. He received the 2010 TWAS Prize and the ICAC Cotton Researcher of the Year Award 2013 for his outstanding contributions to cotton genomics and biotechnology. He was honored as the 2022 Ambassador of Silk Road Friendship (Individual) by the China International Culture Exchange Center (CICEC) and Global People Magazine. He received the 2023 UNESCO-Equatorial Guinea International Prize for Research in the Life Sciences for developing molecular markers to identify desirable traits in cotton, such as disease resistance, fiber quality, and yield. For his joint contribution to COVID-19 vaccine development, he received the 8th Zhongyuan Union Life Medicine International Cooperation Award in 2023, presented by UCAS and VCANBIO Cell & Gene Engineering Corporation, China. In 2023, he was appointed as the Minister of Agriculture of Uzbekistan. He was elected as a Foreign Member of the Academy of Agricultural Sciences of the Republic of Kazakhstan (2024) and the Chinese Academy of Sciences (CAS; 2025). In 2026, he was named a Top Agri-food Pioneer by the World Food Prize Foundation for Uzbekistan in cotton breeding.","orcid":"0000-0001-9563-0686","institutionString":"Academy of Sciences of Uzbekistan","institution":null},{"id":"654263","title":"Dr.","name":"Monochura","middleName":null,"surname":"Saha","slug":"monochura-saha","fullName":"Monochura Saha","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F654263\u002F1763557967\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Monochura Saha is an Assistant Professor of Chemistry at Birla Institute of Technology, Mesra, and a former Postdoctoral Associate at the Massachusetts Institute of Technology (MIT), Media Lab. He earned his Ph.D. in Organic Chemistry from IISER Kolkata, following an M.Sc. from IIT Madras and a B.Sc. in Chemistry from Ramakrishna Mission Vivekananda Centenary College.\nDr. Saha’s research bridges organic synthesis, photochemistry, and chemical biology, with a vision to create smart, stimuli-responsive molecular probes for biosensing, enzyme mimics, and therapeutic applications in metabolic and chronic diseases such as diabetes, obesity, and cancer. His work extends to nanofabrication and bioelectronics, where he has contributed to the design of minimally invasive “injectable devices,” nanoelectronic systems for brain cancer therapy, and wireless platforms for neuromodulation and autoimmune disease management.\nHe has authored impactful publications in leading journals, including Angewandte Chemie, Nature Biotechnology, ACS Applied Materials, and Journal of Physical Chemistry, among others. His scientific contributions have been recognized with prestigious fellowships and awards, including the Department of Science and Technology doctoral fellowship, RSC Best Poster Award, and INSPIRE Scholarship.\nAlongside his research, Dr. Saha is passionate about mentoring young scientists, having guided undergraduate and Ph.D. students in India and abroad. He also serves as a reviewer for journals such as RSC Advances and Scientific Reports. Trained in academic leadership at MIT’s LEAPS program, he brings not only scientific excellence but also a vision for fostering collaboration and innovation in chemical sciences.\nThrough his interdisciplinary research and teaching, Dr. Saha is committed to advancing biomolecular design and translational technologies that can transform diagnostics and therapeutics for global health challenges","orcid":"0000-0002-4722-551X","institutionString":null,"institution":{"name":"Birla Institute of Technology, Mesra","country":{"name":"India"}}},{"id":"157077","title":"Dr.","name":"Federico","middleName":null,"surname":"Durbano","slug":"federico-durbano","fullName":"Federico Durbano","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F157077\u002F1763717110\u002Fprofile\u002Fimage1.jpg","biography":"Federico Durbano is a Doctor of Medicine (MD) with a specialization in Psychiatry. He has worked at various hospitals, including Milan’s Ospedale Maggiore Policlinico, Treviglio, Melegnano, and Fatebenefratelli, where he achieved significant career milestones. He is currently the director of the Mental Health and Addictions Department at ASST Melegnano e della Martesana, Milan, Italy. Dr. Durbano has had teaching assignments at the University of Milan (Nursing School). He is a member of the Italian Society of Psychiatry. He has attended more than 100 local and national congresses and courses as an invited speaker and published over 180 papers and books. He is also a technical advisor to the court in forensic psychiatry.","orcid":null,"institutionString":null,"institution":{"name":"ASST Melegnano e della Martesana","country":{"name":"Italy"}}},{"id":"224131","title":"Associate Prof.","name":"Alfredo","middleName":null,"surname":"Vannacci","slug":"alfredo-vannacci","fullName":"Alfredo Vannacci","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F224131\u002F1761600615\u002Fprofile\u002Fimage1.jpg","biography":"I am a medical toxicologist and teach Pharmacology and Toxicology at the University of Florence.\nMy research focuses on the safety of drugs and herbal medicines, with particular attention to pharmacoepidemiology, pharmacovigilance, and phytovigilance.\n\nI also explore non-conventional medical approaches such as phytotherapy, acupuncture, and traditional Chinese medicine, with a special interest in their theoretical and cultural roots in Eastern philosophies — Daoism, Confucianism, and Buddhism.\n\nMy passion for technology led me to co-found, with my friend Eng. Roberto Bonaiuti, Scarab Lab in 2016 and the academic spin-off DynaMedics in 2021, both dedicated to developing technological solutions for clinical pharmacology and bioinformatics.\n\nFor many years, I have also been committed to perinatal health and to supporting families experiencing pregnancy and neonatal loss — first through the CiaoLapo Association ETS (founded in 2006), and later through the CiaoLapo Foundation ETS (established in 2020), which I co-founded and co-direct with my life and research partner, Dr. Claudia Ravaldi, psychiatrist and psychotherapist.\n\nFinally, I have a long-standing interest in philosophy, particularly in moral philosophy, the philosophy of science and medicine, philosophy of mind, and the ethics of artificial intelligence.","orcid":"0000-0001-5259-2026","institutionString":null,"institution":{"name":"University of Florence","country":{"name":"Italy"}}},{"id":"188756","title":"Associate Prof.","name":"Janko","middleName":null,"surname":"Samardzic","slug":"janko-samardzic","fullName":"Janko Samardzic","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F188756\u002F1779263891\u002Fprofile\u002Fimage1.jpg","biography":"Professor Janko Samardzic is a distinguished pharmacologist at the Medical Faculty of the University of Belgrade. He holds a PhD in Medical Pharmacology and has extensive experience and expertise in Basic and Clinical Pharmacology. Prof. Samardzic completed postdoctoral studies at the University of KU Leuven in Belgium and postgraduate specialty courses at the Erasmus University Medical Centre in Rotterdam. Prof. Samardzic is the author of numerous peer-reviewed papers and book chapters, and a regular speaker at international scientific conferences. He is the winner of the prestigious \"Professor Vladislav Varagic\" award of the Serbian Pharmacological Society for outstanding results achieved in scientific research. Since 2023, Prof. Samardzic has been a Special Advisor and Assistant Minister for international cooperation at the Ministry of Education of the Republic of Serbia.","orcid":"0000-0002-8464-4924","institutionString":null,"institution":{"name":"University of Belgrade","country":{"name":"Serbia"}}},{"id":"651637","title":"Assistant Prof.","name":"Ahmet","middleName":null,"surname":"ÇAKIR","slug":"ahmet-cakir","fullName":"Ahmet ÇAKIR","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F651637\u002F1781098403\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":"","institutionString":null,"institution":{"name":"Inonu University","country":{"name":"Turkey"}}},{"id":"64941","title":"Dr.","name":"Dijana","middleName":null,"surname":"Plaseska-Karanfilska","slug":"dijana-plaseska-karanfilska","fullName":"Dijana Plaseska-Karanfilska","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F64941\u002F1786618473\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Dijana Plaseska-Karanfilska graduated from the Faculty of Medicine, University 'St. Cyril and Methodius” in Skopje, Republic of Macedonia in 1987. She defended the PhD thesis 'Micromethodology for the characterization of haemoglobin variants” in 1994 at the Limburg University, in Maastricht, the Netherlands. Since 1988 Dr.  Plaseska-Karanfilska has been employed at the Research Centre for Genetic Engineering and Biotechnology (RCGEB), Macedonian Academy of Sciences and Arts (MASA) where at present she holds a position of a senior scientist, group leader and head of laboratory. In 2010 she has been elected for Associate Professor of molecular biology and pharmacogenetics at the Faculty of Pharmacy, University 'St. Cyril and Methodius”, Skopje, R. Macedonia. During her professional career Dr. Plaseska-Karanfilska made a contribution to the molecular characterization of different monogenic diseases in Macedonia, such as hemoglobinopathies, cystic fibrosis, cystinuria, Fragile X syndrome, etc. She has been also involved in the research of different infectious diseases, such as HPV, HBV, HCV infections and molecular basis of several malignant diseases as well as forensic DNA identification. Dr. Plaseska-Karanfilska’s recent special research interest is in the field of reproductive genetics, such as male infertility, spontaneous abortion, rapid and non-invasive prenatal diagnosis and breast cancer.","orcid":"","institutionString":null,"institution":{"name":"Macedonian Academy of Sciences and Arts","country":{"name":"Macedonia"}}},{"id":"185693","title":"Prof.","name":"Simon","middleName":null,"surname":"Kaja","slug":"simon-kaja","fullName":"Simon Kaja","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F185693\u002F1763024514\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Kaja is an expert in ocular pharmacology with more than fifteen years' experience in the academic, biotech and pharmaceutical industry setting. Dr. Kaja holds an academic appointment at Loyola University Chicago, where he serves as the Dr. John P. and Therese E. Mulcahy Endowed Professor of Ophthalmology and Director of the Ocular Pharmacology and Drug Discovery Laboratory. \nResearch in the laboratory is currently funded by the National Institute of Health, the Department of Veterans Affairs, Illinois Society for the Prevention of Blindness, Fight for Sight, and industry funding","orcid":"0000-0001-6878-521X","institutionString":null,"institution":{"name":"Loyola University Chicago","country":{"name":"United States of America"}}},{"id":"609304","title":"Prof.","name":"Shubhini A.","middleName":null,"surname":"Saraf","slug":"shubhini-a.-saraf","fullName":"Shubhini A. Saraf","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F609304\u002F1751980812\u002Fprofile\u002Fimage1.jpg","biography":"Prof. Shubhini A. Saraf currently serves as the Director of the National Institute of Pharmaceutical Education and Research (NIPER), Raebareli, India. Prior to this, she was a Professor in the Department of Pharmaceutical Sciences and Director (R&D) at Babasaheb Bhimrao Ambedkar University (A Central University), Lucknow. Prof. Shubhini's academic journey began forty years ago at the Department of Pharmaceutical Sciences, Dr. Harisingh Gour University, Sagar, India, where she completed her B. Pharm, M. Pharm, and Ph.D. in Pharmaceutical Sciences. With over 28 years of teaching and research experience, she has made significant contributions to the field. Her research interests include lipid nanoparticles, nanotechnology through material science research, principles of green nanotechnology, drug targeting approaches, and various techniques of in vitro and in vivo evaluation, such as drug bio-distribution, as well as molecular pharmaceutics and the regulation of cellular markers as indicators of health status. Her work has had a profound impact on the field. She is also actively involved in healthcare technology policy interventions. Prof. Shubhini has an impressive publication record, with more than 180 papers and 22 book chapters to her credit, and is a respected figure in the pharmacy profession.","orcid":"0000-0002-4180-0931","institutionString":"National Institute of Pharmaceutical Education and Research","institution":null},{"id":"191580","title":null,"name":"Ali Gamal","middleName":null,"surname":"Al-Kaf","slug":"ali-gamal-al-kaf","fullName":"Ali Gamal Al-Kaf","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F191580\u002F1710152709\u002Fprofile\u002Fimage1.jpg","biography":"Prof. Dr. Ali Gamal Al-kaf obtained a Ph.D. in Pharmaceutical Sciences in 2006. He is the previous Chief Council for Accreditation and Quality Assurance and former dean of the Faculty of Pharmacy, Sana'a University, Yemen. He is currently the dean of the Faculty of  Medical Sci-ences and a professor in the Medicinal Chemistry Department at the National  University. He is a member of the Yemeni Higher Medical Council and many other associations and internation-al groups. He is also chairman of the Universal Journal of Pharmaceutical Research. Dr. Al-kaf is an editor and associate editor of several international journals. His research interests include the synthesis and biological activity of 4-oxopyrimidine and quinazolinone -4 derivatives, structural biology and bioinformatics in drug design, Yemeni medicinal plants, development and validation of spectrophotometric and high-performance liquid chromatography (HPLC) methods for different drugs, and antibiotic and antimicrobial resistance in Yemen. He is the author of more than ninety articles and fifteen books. He also has four patents to his credit.","orcid":null,"institutionString":null,"institution":{"name":"Sana'a University","country":{"name":"Yemen"}}},{"id":"263906","title":"B.A.","name":"Jo Ann","middleName":null,"surname":"LeQuang","slug":"jo-ann-lequang","fullName":"Jo Ann LeQuang","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F263906\u002F1760439125\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":"0000-0003-4794-0318","institutionString":null,"institution":{"name":"Nema Research (United States)","country":{"name":"United States of America"}}},{"id":"188088","title":"Dr.","name":"Peter","middleName":null,"surname":"Magnusson","slug":"peter-magnusson","fullName":"Peter Magnusson","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F188088\u002F1761128643\u002Fprofile\u002Fimage1.jpg","biography":"Peter Magnusson is a university lecturer at Örebro University in Sweden and a senior consultant in cardiology in Falun, Sweden. He graduated from Lund Medical School and received his PhD from Karolinska Institute, Sweden. His research primarily focuses on cardiology, specifically arrhythmias and cardiomyopathies, but he is also involved in various projects within academic medicine. He is passionate about teaching and supervision. He has been involved in several international projects and has published numerous academic papers on a wide range of topics.","orcid":"0000-0001-7906-7782","institutionString":null,"institution":{"name":"Örebro University","country":{"name":"Sweden"}}},{"id":"44649","title":"Dr.","name":"Benjamin S.","middleName":null,"surname":"Weeks","slug":"benjamin-s.-weeks","fullName":"Benjamin S. Weeks","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F44649\u002F1758615907\u002Fprofile\u002Fimage1.jpg","biography":"Benjamin S. Weeks, Ph.D., earned his doctorate in molecular cell biology in 1988 from the University of Connecticut, Storrs, CT.  His doctoral thesis focused on nutritional support of reproductive health in women.  In 1988, Dr. Weeks joined the National Institute for Dental Research, Bethesda, MD, where he published studies documenting the mechanisms of nutrient and phytochemical support for the nervous and immune systems and wound healing.   In 1995, Dr. Weeks joined the Division of Infectious Diseases at the University of Pennsylvania, Philadelphia, PA, as a Research Associate Professor of Medicine, where his work led to a breakthrough understanding of the anti-inflammatory effects of phytochemicals on viral infection.  In 1997, Dr. Weeks joined the faculty of biology at Adelphi University, Garden City, NY and continued to publish over 80 peer-reviewed manuscripts focused on Vitamin C, policosanol, hemicelluloses, anxiolytic phytochemicals, selenium, and CBD. Dr Weeks’ manuscripts have been published in journals such as The Journal of Cell Biology, The Journal of Biological Chemistry, The Proceedings of the National Academy of Sciences, Fertility and Sterility, Obstetrics and Gynecology, Medical Science Monitor, Cellular Physiology, Immunology and more.  Dr. Weeks also has direct experience working with the nutraceutical industry.  Between 2006 and 2009, Dr. Weeks demonstrated that nutrient extraction procedures patented by inventor Dr. Pedro Perez yielded nutrient products, PolicosnaolPlusTM, PureWayCTM and NatramuneTM, and CBD with enhanced bioactivity.  In 2009, Dr. Weeks developed and formulated RelarianTM for Stephenson Products (SEO Impressions), Little Neck, NY and in 2020, he developed a line of relaxation blends for Calming Co, San Diego, CA.  Dr. Weeks has recently published peer-reviewed articles on using liposomes to package and target nutraceuticals.","orcid":"0000-0002-8361-0677","institutionString":null,"institution":{"name":"Adelphi University","country":{"name":"United States of America"}}},{"id":"514579","title":"Ph.D.","name":"Seçkin","middleName":null,"surname":"Engin","slug":"seckin-engin","fullName":"Seçkin Engin","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F514579\u002F1739446425\u002Fprofile\u002Fimage1.png","biography":"Seçkin Engin received his BS in Pharmacy (2013) from Gazi University in Türkiye and a Ph.D. in Pharmacology (2020)  from the Health Sciences Institute of Karadeniz Technical University in Türkiye. He currently works as a full-time researcher and lecturer in the Department of Pharmacology at the Faculty of Pharmacy at the Karadeniz Technical University. He has published multiple scientific papers and book chapters as the lead author in peer-reviewed international journals. He is also a journal peer reviewer and a member of the editorial boards of journals. His research interests include smooth muscle pharmacology and urogenital system pharmacology, which are focused on identifying novel drugs or drugs repurposing for cystitis and diabetic urological complications such as erectile dysfunction and diabetic cystopathy.","orcid":"0000-0002-1982-7820","institutionString":null,"institution":{"name":"Karadeniz Technical University","country":{"name":"Turkey"}}},{"id":"319705","title":"Dr.","name":"Rahul","middleName":null,"surname":"Shukla","slug":"rahul-shukla","fullName":"Rahul Shukla","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F319705\u002F1748323002\u002Fprofile\u002Fimage1.png","biography":"Dr. Rahul Shukla is currently working as an Assistant Professor in the Department of Pharmaceutics at NIPER Raebareli, Lucknow, an Institute of National Importance under the Ministry of Chemicals and Fertilizers, Government of India. He is listed in the Top 2% Scientists on the Stanford List in Pharmaceutical Sciences worldwide.\r\nHe was awarded the SERB International Research Experience (SIRE) Fellowship for the year 2022-2023 at the School of Pharmacy and Biomedical Sciences, University of Central Lancashire, United Kingdom. Dr. Shukla has experience as a Research Scientist at Dr. Reddy’s Laboratories, India, and as a D.S. Kothari Post-Doctoral Fellow at UIPS, Panjab University, India. He has over ten years of research and academic experience.\r\nHe has published over 120 papers in international peer-reviewed journals and 50 book chapters. He filed 11 patents and 1 copyright. He is an editor for over 7 books published by Elsevier, Springer Nature, and IntechOpen Publishers. His publications include journals such as the Journal of Controlled Release, Molecular Pharmaceutics, International Journal of Pharmaceutics, Expert Opinion, Journal of Drug Targeting, Colloids Surface A & B, Biomaterial Advances, Molecular Neurobiology, and RSC Advances, among others. Dr. Shukla has received funding for his research from DST SERB, AYUSH, and UPCST. \r\nDr. Shukla is a member of the Institutional Animal Ethics Committee and the Institution’s Innovation Committee. He is also a member of the editorial board of the Scientific Reports journal.","orcid":null,"institutionString":null,"institution":{"name":"National Institute of Pharmaceutical Education and Research","country":{"name":"India"}}},{"id":"237059","title":"Dr.","name":"Appavoo","middleName":null,"surname":"Umamaheswari","slug":"appavoo-umamaheswari","fullName":"Appavoo Umamaheswari","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F237059\u002F1740046223\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Appavoo Umamaheswari obtained a Bachelor of Pharmacy\r\nfrom the Tamil Nadu Dr. M. G. R. Medical University in Chennai,\r\nIndia. She received the Thiru Gnana Sebastian Endowment Award\r\nin M. Pharmacy and was awarded the Management Gold Medal award as Best Outgoing Student for the Year 2006 by Periyar\r\nCollege of Pharmaceutical Sciences in India. She obtained a Ph.D. in Pharmaceutical Technology from Anna University in India.\r\nSince 2006, she has worked at Anna University, BIT Campus, Tiruchirappalli, India.\r\nFrom her research expertise and contribution, she has published over 35 peer-reviewed publications in reputed International and National journals, authored 26 book chapters, and edited four books as an editor. To her credit, she has three patents. She serves as a reviewer and editorial board member for various reputed journals. She has\r\ngiven multiple presentations at national and international conferences and is an active member of many professional and academic bodies. Dr. Umamaheswari serves as a referee for various reputed journals and has worked on projects funded by the Department of Science and Technology, New Delhi, India, and the Centre for Sponsored Research and Consultancy, Anna University, India.","orcid":"0000-0002-0896-1530","institutionString":null,"institution":{"name":"Anna University, Chennai","country":{"name":"India"}}},{"id":"174936","title":"Dr.","name":"Ayarivan","middleName":null,"surname":"Puratchikody","slug":"ayarivan-puratchikody","fullName":"Ayarivan Puratchikody","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F174936\u002F1738743251\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":null,"institutionString":null,"institution":{"name":"Anna University, Chennai","country":{"name":"India"}}},{"id":"91590","title":"Dr.","name":"Sakthivel","middleName":null,"surname":"Lakshmana Prabu","slug":"sakthivel-lakshmana-prabu","fullName":"Sakthivel Lakshmana Prabu","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F91590\u002F1740045870\u002Fprofile\u002Fimage1.jpg","biography":"Dr. Sakthivel Lakshmana Prabu has a Ph. D. from Manipal University in Manipal, India. He pursued a postgraduate diploma in IPR law\r\nfrom the National Law School of India University in Bangalore, India. He\r\nhas been working at Anna University, BIT Campus, Tiruchirappalli, India, since 2009. He has more than 25 years of experience,\r\nincluding both in reputed Pharmaceutical Industries and Academic Institutions. From his research contribution, he has published\r\n125 peer-reviewed publications in reputed international and national journals and authored 40 book chapters. As an editor, he edited seven books and co-authored a book entitled “Pharmaceutical Production Management” by Lambert Academic Publishing. To his credit, he has seven patents. He serves as a reviewer and editorial board\r\nmember for various reputed journals. Added to his credit, he organized various national and international conferences, hands-on training, workshops and symposiums.\r\nHe has received funded projects from the Department of Biotechnology, New Delhi, India; the Tamil Nadu State Council for Science and Technology, Tamil Nadu; and the Centre for Sponsored Research and Consultancy, Anna University, Chennai. He has\r\nhad a strong association with Croatian IntechOpen since 2012.","orcid":null,"institutionString":null,"institution":{"name":"Anna University, Chennai","country":{"name":"India"}}},{"id":"332083","title":"Dr.","name":"Rafael","middleName":null,"surname":"Moreno-Gómez-Toledano","slug":"rafael-moreno-gomez-toledano","fullName":"Rafael Moreno-Gómez-Toledano","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F332083\u002F1778740867\u002Fprofile\u002Fimage1.jpg","biography":"Rafael Moreno-Gómez-Toledano, who specializes in Endocrine Disruptors, has focused the majority of his research career on investigating the impacts of bisphenol A (BPA) on the renal and cardiovascular systems. This paradigm encompasses chronic kidney disease and diabetic nephropathy in the renal context, as well as cellular senescence and necroptosis of the vascular endothelium. His latest work has identified new associations between emerging bisphenols that replace BPA (such as BPF or BPS) and diabetes, renal, and cardiovascular pathologies. Subsequently, he worked on creating bioinformatic models for analyzing miRNA targets in cardiovascular pathologies at the Ramón y Cajal Hospital. Currently, he is a professor in the Area of Human Anatomy and Embryology at the University of Alcalá in Spain.","orcid":"0000-0002-4834-289X","institutionString":null,"institution":{"name":"University of Alcalá","country":{"name":"Spain"}}},{"id":"246280","title":"Dr.","name":"Angeliki","middleName":null,"surname":"Siamidi","slug":"angeliki-siamidi","fullName":"Angeliki Siamidi","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F246280\u002F1734011550\u002Fprofile\u002Fimage1.png","biography":"Angeliki Siamidi, MPharm, MSc, PhD, is a postdoctoral researcher in the Department of Pharmaceutical Technology, University of Athens, Greece. Her research focuses on developing and evaluating modified release pharmaceutical formulations. In addition to a number of research papers in international peer-reviewed journals, she has also contributed chapters in scientific books and presented her work at national and international conferences.","orcid":"0000-0002-8664-408X","institutionString":null,"institution":{"name":"National and Kapodistrian University of Athens","country":{"name":"Greece"}}},{"id":"246279","title":"Associate Prof.","name":"Marilena","middleName":null,"surname":"Vlachou","slug":"marilena-vlachou","fullName":"Marilena Vlachou","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F246279\u002F1774860912\u002Fprofile\u002Fimage1.jpg","biography":"Marilena Vlachou is a Professor at the National and Kapodistrian University of Athens (NKUA), Greece. She obtained her Pharmacy and Ph.D. (Pharmaceutical Technology) degrees from the NKUA. Just prior to obtaining her Ph.D. she moved to the University of Rhode Island, United States, as a Visiting Research Scientist to conduct state-of-the art research on Pharmaceutical Technology techniques. Her research interests include: the formulation and in vitro release of bioactive substances from topical formulations; the efficacy and safety of formulations in skin disease therapies; the modified release of novel synthetic derivatives, with diverse activity; the investigation of the physicochemical properties of new excipients, including those of marine origin (Ulvans), and nanomaterials, with respect to their interaction with active pharmaceutical ingredients (APIs); 3D\u002F4D printlets; pediatric delivery systems.","orcid":null,"institutionString":null,"institution":{"name":"National and Kapodistrian University of Athens","country":{"name":"Greece"}}},{"id":"41865","title":"Prof.","name":"Farid","middleName":null,"surname":"Badria","slug":"farid-badria","fullName":"Farid Badria","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F41865\u002F1775720159\u002Fprofile\u002Fimage1.jpg","biography":"Farid A. Badria is Professor of Pharmacognosy at the Faculty of Pharmacy, Mansoura University, Egypt. He holds a Ph.D. from the University of Minnesota and two M.Sc. degrees from Mansoura and the University of Minnesota. He is the founder and director of FAB-Lab, a natural-product drug discovery lab. His awards include the TWAS Prize for Public Understanding of Science, the WIPO Gold Medal, the State Outstanding Award in Medicine, the Outstanding Arab Scholar Award, and the Khawrazmi International Award. Professor Badria has submitted 47 patent applications, authored over 250 publications and 12 books, and continues to lead research on therapies for liver disease, skin disorders, and cancer.","orcid":"0000-0001-7230-3105","institutionString":null,"institution":{"name":"Mansoura University","country":{"name":"Egypt"}}},{"id":"589139","title":"Assistant Prof.","name":"Mohamed","middleName":null,"surname":"Gamaleldin","slug":"mohamed-gamaleldin","fullName":"Mohamed Gamaleldin","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F589139\u002F1756889922\u002Fprofile\u002Fimage1.jpg","biography":null,"orcid":null,"institutionString":"Riyadh Elm University","institution":null},{"id":"599161","title":"M.Sc.","name":"Pathy","middleName":null,"surname":"Lokole","slug":"pathy-lokole","fullName":"Pathy Lokole","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F599161\u002F1727768721\u002Fprofile\u002Fimage1.jpg","biography":"Pharmacist.\nResearcher in phytochemistry and Pharmacognosy.\nResearcher in nano-based drug delivery systems.\nResearcher in Microfluidics development for diagnostic purposes.","orcid":null,"institutionString":null,"institution":{"name":"Rhodes University","country":{"name":"South Africa"}}},{"id":"40046","title":"Prof.","name":"Mourad","middleName":null,"surname":"Aribi","slug":"mourad-aribi","fullName":"Mourad Aribi","position":null,"cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F40046\u002F1729854542\u002Fprofile\u002Fimage1.png","biography":"Dr. Mourad Aribi, Ph.D., Dr. Hab., Ther Immunol., HDR from the University of Montpellier (France), serves as a distinguished professor of immunology at the University of Tlemcen (Algeria). With a remarkable vision, he founded and led the Laboratory of Applied Molecular Biology and Immunology (W0414100). Additionally, he played a key role in introducing bachelor’s, master’s, and doctoral degrees in immunology at the University of Tlemcen. Dr. Aribi’s research endeavors revolve around exploring the modulation of cell-mediated and inflammatory immune responses in autoimmune diseases, cancer, and infectious diseases. Thanks to his interdisciplinary skills, he was able to forge strong collaborations with esteemed institutions worldwide. He has successfully led numerous high-level bilateral and multilateral projects, collaborating with esteemed partners, in particular with partners from CNRS and INSERM (Montpellier, Marseille, Burgundy-Franche-Comté [France]), partners from the Institute for Immunodeficiency (Freibourg [Germany]), and, more recently, partners from Valencia University (Spain, CIBERER, Institute of Health Carlos III), Harvard Medical School (Boston, USA), and Guangdong Provincial People’s Hospital (China). Dr. Aribi’s immense contributions extend beyond his research, as he actively contributes to the scientific community. He serves as a valued reviewer for various international scientific journals and holds a significant position as an editorial board member of Frontiers in Immunology, the official journal of the International Union of Immunological Societies (IUIS). Through these roles, he continues to make meaningful contributions to the dissemination and advancement of scientific knowledge, and he continues to inspire and drive progress in immunological research and its applications for the benefit of society.","orcid":null,"institutionString":"University of Tlemcen","institution":null}]}},"subseries":{"item":{"id":"7","type":"subseries","title":"Bioinformatics and Medical Informatics","keywords":"Biomedical Data, Drug Discovery, Clinical Diagnostics, Decoding Human Genome, AI in Personalized Medicine, Disease-prevention Strategies, Big Data Analysis in Medicine","scope":"Bioinformatics aims to help understand the functioning of the mechanisms of living organisms through the construction and use of quantitative tools. The applications of this research cover many related fields, such as biotechnology and medicine, where, for example, Bioinformatics contributes to faster drug design, DNA analysis in forensics, and DNA sequence analysis in the field of personalized medicine. Personalized medicine is a type of medical care in which treatment is customized individually for each patient. Personalized medicine enables more effective therapy, reduces the costs of therapy and clinical trials, and also minimizes the risk of side effects. Nevertheless, advances in personalized medicine would not have been possible without bioinformatics, which can analyze the human genome and other vast amounts of biomedical data, especially in genetics. The rapid growth of information technology enabled the development of new tools to decode human genomes, large-scale studies of genetic variations and medical informatics. The considerable development of technology, including the computing power of computers, is also conducive to the development of bioinformatics, including personalized medicine. In an era of rapidly growing data volumes and ever lower costs of generating, storing and computing data, personalized medicine holds great promises. Modern computational methods used as bioinformatics tools can integrate multi-scale, multi-modal and longitudinal patient data to create even more effective and safer therapy and disease prevention methods. Main aspects of the topic are: Applying bioinformatics in drug discovery and development; Bioinformatics in clinical diagnostics (genetic variants that act as markers for a condition or a disease); Blockchain and Artificial Intelligence\u002FMachine Learning in personalized medicine; Customize disease-prevention strategies in personalized medicine; Big data analysis in personalized medicine; Translating stratification algorithms into clinical practice of personalized medicine.","coverUrl":"https:\u002F\u002Fcdn.intechopen.com\u002Fseries_topics\u002Fcovers\u002F7.jpg","hasOnlineFirst":true,"hasPublishedBooks":true,"annualVolume":7,"isSalesforceSubseries":true,"editor":{"id":"351533","title":null,"name":"Slawomir","middleName":null,"surname":"Wilczynski","slug":"slawomir-wilczynski","fullName":"Slawomir Wilczynski","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F351533\u002F1734438176\u002Fprofile\u002Fimage1.jpg","biography":"Prof. Dr. Sławomir Wilczyński is head of the Department of Basic Biomedical Sciences at the Medical University of Silesia in Katowice, Poland. He is professionally involved in the field of bioengineering and bioinformatics. His scientific interests are focused on modern imaging methods used in medicine and pharmacy, including hyperspectral imaging, dynamic thermal analysis, high-resolution ultrasound, as well as other techniques such as EPR, NMR, and hemispherical directional reflectance. He is the author of over 200 scientific papers, patents, and industrial designs. He is editor-in-chief of a professional journal in the field of aesthetic medicine and dermatology, Aesthetica, and editor of Advances in Therapy (Springer Nature). In his research, he utilizes bioengineering and bioinformatics methods to collaboratively develop innovative cosmetic products with Cosmetics Factory MG Evolution®.","institutionString":null,"institution":{"name":"Medical University of Silesia","institutionURL":null,"country":{"name":"Poland"}}},"editorTwo":null,"editorThree":null,"associateEditorOne":null,"associateEditorTwo":null,"associateEditorThree":null,"series":{"id":"7","title":"Biomedical Engineering","doi":"10.5772\u002Fintechopen.71985","issn":"2631-5343"},"editorialBoard":[{"id":"5886","title":"Dr.","name":"Alexandros","middleName":"T.","surname":"Tzallas","slug":"alexandros-tzallas","fullName":"Alexandros T. Tzallas","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F5886\u002F1732711235\u002Fprofile\u002Fimage1.png","institutionString":null,"institution":{"name":"University of Ioannina","institutionURL":null,"country":{"name":"Greece"}}},{"id":"257388","title":"Prof.","name":"Lulu","middleName":null,"surname":"Wang","slug":"lulu-wang","fullName":"Lulu Wang","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F257388\u002F1782483734\u002Fprofile\u002Fimage1.jpg","institutionString":null,"institution":{"name":"Reykjavík University","institutionURL":null,"country":{"name":"Iceland"}}},{"id":"225387","title":"Prof.","name":"Reda","middleName":"R.","surname":"Gharieb","slug":"reda-gharieb","fullName":"Reda R. Gharieb","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F225387\u002F1715245081\u002Fprofile\u002Fimage1.jpg","institutionString":null,"institution":{"name":"Assiut University","institutionURL":null,"country":{"name":"Egypt"}}}],"_topicEditors":[{"id":"351533","title":null,"name":"Slawomir","middleName":null,"surname":"Wilczynski","slug":"slawomir-wilczynski","fullName":"Slawomir Wilczynski","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F351533\u002F1734438176\u002Fprofile\u002Fimage1.jpg","biography":"Prof. Dr. Sławomir Wilczyński is head of the Department of Basic Biomedical Sciences at the Medical University of Silesia in Katowice, Poland. He is professionally involved in the field of bioengineering and bioinformatics. His scientific interests are focused on modern imaging methods used in medicine and pharmacy, including hyperspectral imaging, dynamic thermal analysis, high-resolution ultrasound, as well as other techniques such as EPR, NMR, and hemispherical directional reflectance. He is the author of over 200 scientific papers, patents, and industrial designs. He is editor-in-chief of a professional journal in the field of aesthetic medicine and dermatology, Aesthetica, and editor of Advances in Therapy (Springer Nature). In his research, he utilizes bioengineering and bioinformatics method