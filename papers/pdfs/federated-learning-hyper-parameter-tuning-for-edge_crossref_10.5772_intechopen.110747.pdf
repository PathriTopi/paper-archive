"institutionString":null,"countryString":null,"institution":{"name":"University of Auckland","country":{"name":"New Zealand"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"1005328","title":"Polyamines in Human Disease","subtitle":null,"fullTitle":"Polyamines in Human Disease","hash":"1f0bc9fa35445425db0fa19e95393af3","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000JdxBlIAJ\u002F0017232_TrikoderCover%20%282025-07-03%2013%3A27%3A07%29.jpg","kuFlag":false,"editedByType":null,"isOpenForSubmission":true,"editors":[{"id":"645637","name":"Xolani","surname":"Makhoba","fullName":"Xolani Makhoba","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F645637\u002F1751868606\u002Fprofile\u002Fimage1.jpg","institutionString":null,"countryString":null,"institution":{"name":"University of South Africa","country":{"name":"South Africa"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}},{"type":"book","id":"1004584","title":"Particle Accelerators and High-Energy Experimental Particle Physics","subtitle":null,"fullTitle":"Particle Accelerators and High-Energy Experimental Particle Physics","hash":"0c83059123a1129ed285c4d7be2d27cb","coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa04Tc00000ARjzNIAT\u002F0016488_TrikoderCover%20%282024-09-23%2012%3A02%3A46%29.jpg","kuFlag":false,"editedByType":null,"isOpenForSubmission":true,"editors":[{"id":"622305","name":"Theodota","surname":"Lagouri","fullName":"Theodota Lagouri","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F622305\u002F1734032535\u002Fprofile\u002Fimage1.jpg","institutionString":null,"countryString":null,"institution":{"name":"European Organization for Nuclear Research","country":{"name":"Switzerland"}}}],"productType":{"id":"1","chapterContentType":"chapter","authoredCaption":"Edited by"}}]},"welcomeNews":[{"id":"624","slug":"8000k-technology-cultural-heritage-and-scientific-diplomacy-20260430","title":"Reaching New Heights: IntechOpen Publishes its 8,000th Open Access Book","intro":"\u003Cp\u003EIntechOpen is proud to announce a significant milestone for 2026: the publication of our 8,000th open access book. This milestone comes shortly after the 20th anniversary of the publication of our first OA book.\u003C\u002Fp\u003E","introHomepage":null,"publishedDatetime":"May 6, 2026","isClimateNews":false,"mainMedia":{"id":"589","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F589"}},{"id":"435","slug":"intechopen-book-wins-the-2022-international-academy-of-astronautics-life-science-book-award-20230328","title":"IntechOpen Book Wins the 2022 International Academy of Astronautics Life Science Book Award","intro":"\u003Cp\u003EWe are thrilled that the International Academy of Astronautics has chosen IntechOpen&#39;s book &quot;Preparation of Space Experiments&quot;, edited by Dr. Vladimir Pletser, to receive the IAA Life Science&nbsp;Book Award. The award is given annually to recognize excellence in publication by an Academy member or corresponding member in the field of life sciences.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EWe are thrilled that the International Academy of Astronautics has chosen IntechOpen&#39;s book &quot;Preparation of Space Experiments&quot;, edited by Dr. Vladimir Pletser, to receive the IAA Life Science&nbsp;Book Award. The award is given annually to recognize excellence in publication by an Academy member or corresponding member in the field of life sciences.\u003C\u002Fp\u003E","publishedDatetime":"March 28, 2023","isClimateNews":false,"mainMedia":{"id":"325","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F325"}},{"id":"416","slug":"intechopen-retains-its-dominant-position-in-growing-oa-market-20230217","title":"IntechOpen Retains Its Dominant Position in Growing OA Market","intro":"\u003Cp\u003EIn their analysis of the latest data from the Directory of Open Access Books (DOAB), Delta Think, a strategic consulting and advisory firm, confirmed that IntechOpen remains the largest publisher across all years, with a share of 9.6%.\u003C\u002Fp\u003E","introHomepage":"\u003Cp\u003EIn their analysis of the latest data from the Directory of Open Access Books (DOAB), Delta Think, a strategic consulting and advisory firm, confirmed that IntechOpen remains the largest publisher across all years, with a share of 9.6%.\u003C\u002Fp\u003E","publishedDatetime":"February 17, 2023","isClimateNews":false,"mainMedia":{"id":"357","caption":"","originalUrl":"\u002Fmedia\u002Foriginal\u002F357"}}],"regionStatistics":[{"id":"1","name":"Southern Europe","contributorCount":21370},{"id":"2","name":"Northern Europe","contributorCount":6960},{"id":"3","name":"Western Europe","contributorCount":10652},{"id":"4","name":"Northern America","contributorCount":17996},{"id":"5","name":"Eastern Asia","contributorCount":20252},{"id":"6","name":"Australia and New Zealand","contributorCount":2718}],"intechStatistics":{"openAccessBooks":"8,100","internationalAuthorsAndEditors":"206,000","downloads":"235M","deliversInCountries":"154","authorsAmongMostCitedScientists":"TOP 1%","authorsAndEditorsFromTopUniversities":"14%","dimensionsCitations":564530,"crossrefCitations":269736,"researchInstitutions":11679,"scientificWorks":89364},"srcParam":"","chapterId":"","pageFlags":{"lowEconomy":0,"isFromSpain":0,"isEditorContact":0,"isFromIowaStateUniversity":0,"isFromBarcelonaUniversity":0,"isFromAlcalaUniversity":0},"isFromSpain":false,"regionId":"","selectedRegionStatistics":null,"economyCat":null,"isEditorContact":false,"isFromIowaStateUniversity":false,"isFromBarcelonaUniversity":false,"isFromAlcalaUniversity":false},"ofsBookV4New":{"item":{"type":"book","id":"1003069","leadTitle":null,"title":"Reverse Engineering - Emerging Challenges, New Perspectives and Innovative Applications","fullTitle":"Reverse Engineering - Emerging Challenges, New Perspectives and Innovative Applications","subtitle":null,"reviewType":"peer-reviewed","abstract":"Reverse Engineering is certainly not a new domain. It is a largely accepted and well-established practice in various scientific fields such as mechanical engineering, computer science, electrical engineering, chemical production, life sciences, and many more. Despite this diversity, the reason for the development and the evolution of reverse engineering methodologies is almost common in most application fields, i.e., the original design data and technical documentation of a product are either not updated, not accessible, do not exist anymore, or even have never existed. Focusing on the mechanical engineering domain, the subject of reverse engineering has traditionally been considered the reconstruction of the geometrical shape and form of a physical object. However, to efficiently address a wide spectrum of demanding industrial applications, the current meaning of reverse engineering refers not only to the 3D-CAD model reconstruction but also to sophisticated product design processes that require experimental and numerical analyses and calculations.\r\nIn the fast-paced industrial environment of today, where technological advancement continuously craves greater product efficiency, reliability, and quality, reverse engineering methods and tools are now facing a much broader set of challenges. Primarily aiming at the capture of technological knowledge, the improvement, and optimization of the original product than its’ mere duplication, reverse engineering plays a key role in the era of the fourth industrial revolution. This book aims to present tomorrow’s known and anticipated challenges in reverse engineering methodology and applications. It intends to illustrate cutting-edge research and development in critical areas such as data capturing, processing, and evaluation techniques, along with the presentation of real-world industrial and multidisciplinary applications of reverse engineering. The major objective of this project is to provide an invaluable reference tool for practitioners, designers, engineers, and educators.","isbn":"978-1-83769-828-8","printIsbn":"978-1-83769-829-5","pdfIsbn":"978-1-83769-830-1","doi":"10.5772\u002Fintechopen.111099","oapfPrice":1400,"oapfPriceCurrency":"GBP","isOpenForSubmission":false,"isSalesforceBook":true,"isNomenclature":false,"hash":"26827e9c1e49ba03d0ccd6fb85857d42","bookSignature":"Dr. George Kaisarlis","publishedDate":null,"coverURL":"https:\u002F\u002Fintech-files.s3.amazonaws.com\u002Fa043Y00000zFsn5QAC\u002F0014973_TrikoderCover%20%282023-01-13%2008%3A17%3A12%29.jpg","keywords":["Design Intent"," Knowledge Management Systems"," 3D Scanning"," CMM Techniques"," CAD"," CAM"," 3D Geometrical Modeling"," Segmentation and Triangulation"," Medical Devices"," Customized Implants"," Digital Heritage"," Virtual Restoration"],"dateEndFirstStepPublish":"10 May 2023","dateEndSecondStepPublish":"05 July 2023","dateEndThirdStepPublish":"09 August 2023","dateEndFourthStepPublish":"28 October 2023","dateEndFifthStepPublish":"27 December 2023","dateConfirmationOfParticipation":"30 June 2023","dateOldSubmissionDeadline":null,"remainingDaysToSecondStep":"3 years","secondStepPassed":true,"areRegistrationsClosed":true,"currentStepOfPublishingProcess":5,"editedByType":null,"sdgRelated":false,"biosketch":"Dr. Kaisarlis's key areas of scientific activity are Reverse Engineering, Advanced Geometrical, Dimensional Tolerancing Techniques, Industrial Dimensional Metrology, as well as product design methodologies, CAD\u002FCAE\u002FCAM, and free-form surface digitization and verification. He is a reviewer in top-rank international scientific journals.  He is a member of the Technical Chamber of Greece, the Hellenic Association of Mechanical–Electrical Engineers, and the American Society of Mechanical Engineers.","equalEditorOneBiosketch":null,"equalEditorTwoBiosketch":null,"equalEditorThreeBiosketch":null,"coeditorOneBiosketch":null,"coeditorTwoBiosketch":null,"coeditorThreeBiosketch":null,"coeditorFourBiosketch":null,"coeditorFiveBiosketch":null,"isPublished":false,"isDeactivated":true,"ofsPageFlags":null,"hasEditors":true,"editors":[{"id":"89709","name":"George","surname":"Kaisarlis","fullName":"George Kaisarlis","cdnProfilePictureURL":"https:\u002F\u002Fcdnintech.com\u002Fmedia\u002Fauthor\u002F89709\u002F1734011598\u002Fprofile\u002Fimage1.jpg","biography":"George Kaisarlis earned a Ph.D. in Mechanical Engineering (2007) from the National Technical University of Athens (NTUA), Greece, and a Diploma (M.Eng.) in Mechanical Engineering (NTUA - 1997). He has published over 60 papers in peer-reviewed scientific journals and conference proceedings and has participated in numerous EU and National research projects. He is currently a research and teaching assistant in the Rapid Prototyping – Tooling & Reverse Engineering Laboratory of the Mechanical Design and Control Systems Department in the Mechanical Engineering School of NTUA. The key areas of his scientific activity are focused on Reverse Engineering, Advanced Geometrical, Dimensional Tolerancing Techniques, and Industrial Dimensional Metrology. His scientific activity also extends to product design methodologies, CAD\u002FCAE\u002FCAM, and free-form surface digitization and verification. He is frequently an invited reviewer in top-rank international scientific journals.  Along with his academic and research activities, Dr. Kaisarlis has more than 20 years of work experience in the manufacturing industry. He is a member of the Technical Chamber of Greece, the Hellenic Association of Mechanical–Electrical Engineers, and the American Society of Mechanical Engineers. He is also active as an appointed Technical Expert (WG2\u002FWG10\u002FWG17\u002FWG18) and as an accredited national delegate (ELOT\u002FNQIS) in ISO TC\u002F213 'Dimensional and geometrical product specifications and verification”.","institutionString":null,"c