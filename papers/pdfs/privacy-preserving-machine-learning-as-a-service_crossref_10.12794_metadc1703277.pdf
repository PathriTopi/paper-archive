<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html;  charset=UTF-8" />
    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAM</title>
    <link rel="stylesheet" href="/digital/media/dam/dam.css">
    <script async defer src="/digital/media/altcha/altcha.min.js" type="module"></script>
</head>
<body>
    <div id="altcha-content">
        <h1><img src="/digital/media/assets/public/images/dl/favicons/favicon.ico"> digital.library.unt.edu</h1>
        <h2>Gauging your humanity...This may take some seconds.</h2>
        <div>
            <form id="altcha-submission">
                <input type="hidden" name="csrfmiddlewaretoken" value="iqdwOcCMknQptJTnJNKaoI7B3hBfq0sMhnKtIFecTkGIHhURK09HgxWNgzSxpUL4">
                <altcha-widget id="altcha"></altcha-widget>
            </form>
        </div>
        
            <h3>If you are unable to reach our site content, please <a href="https://digital.library.unt.edu/feedback/?cat=Technical+Issue&user_feedback=Altcha+Challenge+Issue+Details%3A">let us know</a>.</h3>
        
    </div>
    <script type="text/javascript">
        window.addEventListener("load", () => {
            document.querySelector("#altcha").configure({
                challenge: {
                    algorithm: "SHA-256",
                    challenge: "1225859b592225389440d713458faa55b4caeccc4c8dbf4b8dff1bd32e811971",
                    salt: "e0321e26d77383a2f0c72d73?expires=1786735731",
                    signature: "27ae303276b7b81982492e04159364fc5b709bad1d797c2a87e728cab8e81d1f",
                    maxnumber: "500000",
                },
                auto: "none",
                debug: false,
                delay: 0,
                hidefooter: true,
                hidelogo: false,
            });
        });
        document.querySelector("altcha-widget").addEventListener("statechange", async (e) => {
            await e.detail;
            if (e.detail.state === "verified") {
                const challengeData = new FormData(document.forms["altcha-submission"]);
                try {
                   const response = await fetch("/dam/submit/", {
                        method: "POST",
                        body: challengeData,
                    });
                    const result = await response.json();
                    if ("success" in result) {
                        window.location.replace("/ark:/67531/metadc1703277/m2/1/high_res_d/HESAMIFARD\u002DDISSERTATION\u002D2020.pdf");
                    } else {
                        document.getElementById('altcha-content').innerHTML = `${result.error} If you are unable to reach our site content, please <a href="https://digital.library.unt.edu/feedback/?cat=Technical+Issue&user_feedback=Altcha+Challenge+Issue+Details%3A">let us know</a>.`;
                    }
                } catch (error) {
                    document.getElementById('altcha-content').innerHTML = `${error} If you are unable to reach our site content, please <a href="https://digital.library.unt.edu/feedback/?cat=Technical+Issue&user_feedback=Altcha+Challenge+Issue+Details%3A">let us know</a>.`;
                    console.error("Challenge submission error:", error);
                }
            }
        });
    </script>
</body>
</html>
